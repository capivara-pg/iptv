<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <corners android:radius="40px"/>
            <solid android:color="@color/color_789c9c9c"/>
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape>
                <corners
                    android:topLeftRadius="40px"
                    android:topRightRadius="40px"
                    android:bottomLeftRadius="40px"
                    android:bottomRightRadius="40px"/>
                <solid android:color="#fe9732"/>
            </shape>
        </clip>
    </item>
</layer-list>
