<?xml version="1.0" encoding="utf-8"?>
<com.zhy.autolayout.AutoLinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/mLlContent"
    android:paddingLeft="28px"
    android:paddingRight="28px"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="28px">
    <ImageView
        android:id="@+id/mIvBackground"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="96px"
        android:layout_marginTop="48px"
        android:scaleType="fitXY"/>
    <com.zhy.autolayout.AutoLinearLayout
        android:orientation="horizontal"
        android:id="@+id/mLlPackage"
        android:background="@drawable/icon_home_special_package_bg"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="96px"
        android:layout_marginTop="48px">
        <ImageView
            android:layout_width="96px"
            android:layout_height="96px"
            android:src="@drawable/icon_home_special_package"/>
        <TextView
            android:textSize="24px"
            android:textColor="@color/color_6F4935"
            android:gravity="center"
            android:id="@+id/mTvPackage"
            android:layout_width="0px"
            android:layout_height="match_parent"
            android:layout_weight="1"/>
        <TextView
            android:textSize="28px"
            android:textColor="@color/color_F9F0E7"
            android:gravity="center"
            android:background="@drawable/bg_home_special_package_btn"
            android:layout_width="156px"
            android:layout_height="56px"
            android:layout_marginRight="40px"
            android:text="@string/mine_join_vip"/>
    </com.zhy.autolayout.AutoLinearLayout>
    <com.zhy.autolayout.AutoLinearLayout
        android:orientation="horizontal"
        android:id="@+id/mLlBind"
        android:background="@drawable/icon_home_bind_gift_bg"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="96px"
        android:layout_marginTop="48px">
        <ImageView
            android:layout_width="96px"
            android:layout_height="96px"
            android:src="@drawable/icon_home_bind_gift"/>
        <TextView
            android:textSize="24px"
            android:textColor="@color/color_F1CE9A"
            android:gravity="center"
            android:id="@+id/mTvBind"
            android:layout_width="0px"
            android:layout_height="match_parent"
            android:layout_weight="1"/>
        <TextView
            android:textSize="28px"
            android:textColor="@color/color_000000"
            android:gravity="center"
            android:background="@drawable/bg_home_bind_gift_btn"
            android:layout_width="156px"
            android:layout_height="56px"
            android:layout_marginRight="40px"
            android:text="@string/am_to_bind"/>
    </com.zhy.autolayout.AutoLinearLayout>
</com.zhy.autolayout.AutoLinearLayout>
