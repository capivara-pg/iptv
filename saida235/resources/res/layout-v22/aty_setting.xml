<?xml version="1.0" encoding="utf-8"?>
<com.zhy.autolayout.AutoLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/color_FF1C1D23"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.mobile.brasiltv.view.TitleBarView
        android:id="@+id/mTbvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:titleBgColor="@color/color_FF292A30"
        app:titleText="@string/menu_setting"
        app:titleTextColor="@color/color_ffffff"/>
    <com.mobile.brasiltv.view.setting.MenuItem
        android:id="@+id/mMiNotify"
        android:background="@color/color_FF292A30"
        android:layout_width="match_parent"
        android:layout_height="104px"
        android:layout_marginTop="15px"
        app:menuIcon="@drawable/icon_mine_notification"
        app:menuName="@string/msg_notification"
        app:menuRightIcon="@drawable/icon_mine_arrow"/>
    <com.mobile.brasiltv.view.setting.MenuItem
        android:id="@+id/mMiUpgrade"
        android:background="@color/color_FF292A30"
        android:layout_width="match_parent"
        android:layout_height="104px"
        app:menuFlag="@drawable/icon_new_version"
        app:menuIcon="@drawable/icon_mine_check"
        app:menuInfo="V 1.0.1"
        app:menuName="@string/mine_check"
        app:menuRightIcon="@drawable/icon_mine_arrow"/>
    <com.mobile.brasiltv.view.setting.MenuItem
        android:id="@+id/mMiAboutUs"
        android:background="@color/color_FF292A30"
        android:layout_width="match_parent"
        android:layout_height="104px"
        app:menuIcon="@drawable/icon_mine_about"
        app:menuName="@string/mine_about"
        app:menuRightIcon="@drawable/icon_mine_arrow"/>
    <com.zhy.autolayout.AutoFrameLayout
        android:background="@color/color_FF292A30"
        android:paddingLeft="25px"
        android:paddingRight="25px"
        android:layout_width="match_parent"
        android:layout_height="104px"
        android:paddingHorizontal="25px">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/mIvMenuIcon"
            android:background="@drawable/icon_data_play_video"
            android:layout_width="48px"
            android:layout_height="48px"
            android:scaleType="fitCenter"/>
        <TextView
            android:textColor="@color/ffffff"
            android:layout_gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="58px"
            android:text="@string/mine_use_data_play"/>
        <TextView
            android:layout_gravity="end|center_vertical"
            android:id="@+id/mSwitchDataPlay"
            android:background="@drawable/selector_mine_setting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginEnd="25px"/>
    </com.zhy.autolayout.AutoFrameLayout>
    <com.zhy.autolayout.AutoFrameLayout
        android:id="@+id/mFlSwitchDataDownload"
        android:background="@color/color_FF292A30"
        android:paddingLeft="25px"
        android:paddingRight="25px"
        android:layout_width="match_parent"
        android:layout_height="104px"
        android:paddingHorizontal="25px">
        <ImageView
            android:layout_gravity="center"
            android:background="@drawable/icon_data_download"
            android:layout_width="48px"
            android:layout_height="48px"
            android:scaleType="fitCenter"/>
        <TextView
            android:textColor="@color/ffffff"
            android:layout_gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="58px"
            android:text="@string/mine_use_data_download"/>
        <TextView
            android:layout_gravity="end|center_vertical"
            android:id="@+id/mSwitchDataDownload"
            android:background="@drawable/selector_mine_setting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginEnd="25px"/>
    </com.zhy.autolayout.AutoFrameLayout>
</com.zhy.autolayout.AutoLinearLayout>
