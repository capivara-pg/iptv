<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/color_1f202a"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.mobile.videodownloads.view.TitleViews
        android:id="@+id/titleDownload"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/color_ffffff"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/tv_downloadAll"
        android:background="@drawable/shape_download_all"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginLeft="13dp"
        android:layout_marginTop="10dp"
        android:layout_marginRight="13dp"
        android:layout_marginBottom="10dp"
        android:layout_marginHorizontal="13dp"
        android:layout_marginVertical="10dp"
        app:layout_constraintBottom_toTopOf="@+id/recycler_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/titleDownload"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        app:layout_constraintBottom_toTopOf="@+id/conBottom"
        app:layout_constraintTop_toBottomOf="@+id/tv_downloadAll"/>
    <include
        android:id="@+id/mAutoRenewalStatus"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/conBottom"
        app:layout_constraintTop_toBottomOf="@+id/titleDownload"
        layout="@layout/item_auto_renewal_status"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/conBottom"
        android:background="@color/color_191a23"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        app:layout_constraintBottom_toBottomOf="parent">
        <TextView
            android:textColor="@color/color_ffffff"
            android:id="@+id/tvNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15dp"
            android:layout_marginTop="5dp"
            android:text="@string/number_downloads"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="11sp"
            android:textColor="@color/color_f0f0f0"
            android:id="@+id/tvBtFs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/tvBtFsnu"
            app:layout_constraintRight_toLeftOf="@+id/tvBtFsnu"/>
        <TextView
            android:textSize="11sp"
            android:textColor="@color/color_999999"
            android:id="@+id/tvBtFsnu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="17dp"
            app:layout_constraintBottom_toBottomOf="@+id/tvNumber"
            app:layout_constraintRight_toRightOf="parent"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/color_ffffff"
            android:id="@+id/tvFreeSpace"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15dp"
            android:layout_marginTop="5dp"
            android:text=""
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvNumber"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/color_ffffff"
            android:id="@+id/tvTotalSpace"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15dp"
            android:layout_marginTop="5dp"
            android:layout_marginRight="16dp"
            android:text=""
            app:layout_constraintBottom_toBottomOf="@+id/tvFreeSpace"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tvFreeSpace"/>
        <ProgressBar
            android:id="@+id/progressbar"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginLeft="15dp"
            android:layout_marginRight="15dp"
            android:max="100"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvFreeSpace"
            style="@android:style/Widget.ProgressBar.Horizontal"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/delCon"
        android:background="@color/color_191a23"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        app:layout_constraintBottom_toBottomOf="parent">
        <TextView
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/color_ffffff"
            android:gravity="center"
            android:id="@+id/tvSelectAll"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/viewDel"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/viewDel"
            android:background="@color/color_242633"
            android:layout_width="1dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/tvSelectAll"
            app:layout_constraintLeft_toRightOf="@+id/tvSelectAll"
            app:layout_constraintRight_toLeftOf="@+id/tvDel"
            app:layout_constraintTop_toTopOf="@+id/tvSelectAll"/>
        <TextView
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/color_999999"
            android:gravity="center"
            android:id="@+id/tvDel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/Delete"
            app:layout_constraintLeft_toRightOf="@+id/viewDel"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
