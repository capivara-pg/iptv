<?xml version="1.0" encoding="utf-8"?>
<com.zhy.autolayout.AutoLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.zhy.autolayout.AutoFrameLayout
        android:layout_width="match_parent"
        android:layout_height="306px"
        android:layout_marginLeft="8px"
        android:layout_marginRight="8px">
        <com.mobile.brasiltv.view.RoundedImageView
            android:id="@+id/mIvPost"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            app:riv_corner_radius="6dp"/>
        <TextView
            android:textSize="20px"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/mTvScore"
            android:layout_width="56px"
            android:layout_height="32px"/>
        <TextView
            android:textSize="20px"
            android:textColor="@color/white"
            android:gravity="bottom|center_horizontal"
            android:layout_gravity="bottom"
            android:id="@+id/mTvInfo"
            android:background="@drawable/bg_shadow_series_info"
            android:paddingBottom="14px"
            android:layout_width="match_parent"
            android:layout_height="90px"/>
    </com.zhy.autolayout.AutoFrameLayout>
    <TextView
        android:textSize="24px"
        android:textColor="@color/white"
        android:ellipsize="end"
        android:id="@+id/mTvName"
        android:paddingLeft="8px"
        android:paddingRight="8px"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12px"
        android:layout_marginBottom="40px"
        android:singleLine="true"
        android:includeFontPadding="false"/>
</com.zhy.autolayout.AutoLinearLayout>
