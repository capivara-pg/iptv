<?xml version="1.0" encoding="utf-8"?>
<com.zhy.autolayout.AutoFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:focusable="true"
    android:layout_width="48dp"
    android:layout_height="48dp">
    <TextView
        android:textSize="16sp"
        android:textColor="#ffff"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/mTextTitle"
        android:duplicateParentState="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <ImageView
        android:layout_gravity="end|bottom"
        android:id="@+id/mDownloadLayout"
        android:visibility="gone"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@drawable/anim_download_episode_progress"/>
    <ImageView
        android:id="@+id/mIvSelect"
        android:visibility="gone"
        android:duplicateParentState="true"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginLeft="2dp"
        android:layout_marginTop="2dp"/>
    <ImageView
        android:layout_gravity="end|bottom"
        android:id="@+id/mIvDownload"
        android:visibility="gone"
        android:layout_width="16dp"
        android:layout_height="16dp"/>
</com.zhy.autolayout.AutoFrameLayout>
