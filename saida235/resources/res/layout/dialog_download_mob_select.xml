<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/conDownloadLayout"
    android:background="@drawable/shape_bg_pop_download"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="18sp"
        android:textColor="@color/color_ffffff"
        android:gravity="bottom"
        android:id="@+id/tvTitle"
        android:paddingTop="16dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginBottom="16dp"
        android:text="@string/please_select_resource"
        app:layout_constraintBottom_toTopOf="@+id/resolution"
        app:layout_constraintLeft_toLeftOf="parent"/>
    <ImageView
        android:id="@+id/imgClose"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="16dp"
        android:src="@mipmap/icon_download_close"
        app:layout_constraintBottom_toBottomOf="@+id/tvTitle"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tvTitle"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/color_e2e2e2"
        android:id="@+id/resolution"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginBottom="12dp"
        android:text="@string/resolution"
        app:layout_constraintBottom_toTopOf="@+id/qualityRecyclerView"
        app:layout_constraintLeft_toLeftOf="parent"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/qualityRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toTopOf="@+id/secondBarrier"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/secondBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="top"
        app:constraint_referenced_ids="movieCon,tvSeason"/>
    <include
        android:id="@+id/movieCon"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/conDownload"
        layout="@layout/layout_download_mob_movie_info"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/color_e2e2e2"
        android:id="@+id/tvSeason"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginBottom="12dp"
        android:text="Season"
        app:layout_constraintBottom_toTopOf="@+id/thirdBarrier"
        app:layout_constraintLeft_toLeftOf="parent"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/color_ffffff"
        android:id="@+id/tvEpisodes"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:text="Episodes"
        app:layout_constraintBottom_toBottomOf="@+id/tvSeason"
        app:layout_constraintLeft_toRightOf="@+id/tvSeason"
        app:layout_constraintTop_toTopOf="@+id/tvSeason"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/thirdBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="top"
        app:constraint_referenced_ids="mSelectionTabView,mSelectionView"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/mSelectionTabView"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toTopOf="@+id/mSelectionView"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/mSelectionView"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        app:layout_constraintBottom_toTopOf="@+id/conDownload"
        app:layout_constraintHeight_max="329dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/conDownload"
        android:background="@color/color_36383D"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        app:layout_constraintBottom_toBottomOf="parent">
        <TextView
            android:textSize="12sp"
            android:textColor="@color/color_important"
            android:id="@+id/tvBtT"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="4dp"
            android:text="@string/download_management"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/imgMore"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:background="@color/color_important"
            android:layout_width="0dp"
            android:layout_height="1dp"
            app:layout_constraintLeft_toLeftOf="@+id/tvBtT"
            app:layout_constraintRight_toRightOf="@+id/tvBtT"
            app:layout_constraintTop_toBottomOf="@+id/tvBtT"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/conBtDn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="16dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:textSize="10sp"
                android:textColor="@color/color_999999"
                android:id="@+id/tvBtDnTips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="5dp"
                android:text="@string/available_space"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toLeftOf="@+id/tvBtDn"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="10sp"
                android:textColor="@color/color_ffffff"
                android:id="@+id/tvBtDn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                app:layout_constraintBottom_toBottomOf="@+id/tvBtDnTips"
                app:layout_constraintLeft_toRightOf="@+id/tvBtDnTips"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="@+id/tvBtDnTips"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/conBtFs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="8dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/conBtDn">
            <TextView
                android:textSize="10sp"
                android:textColor="@color/color_999999"
                android:id="@+id/tvBtFsTips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="5dp"
                android:text="@string/number_downloads"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toLeftOf="@+id/tvBtFs"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="10sp"
                android:textColor="@color/color_ffffff"
                android:id="@+id/tvBtFs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                app:layout_constraintBottom_toBottomOf="@+id/tvBtFsTips"
                app:layout_constraintLeft_toRightOf="@+id/tvBtFsTips"
                app:layout_constraintRight_toLeftOf="@+id/tvBtFsnu"
                app:layout_constraintTop_toTopOf="@+id/tvBtFsTips"/>
            <TextView
                android:textSize="10sp"
                android:textColor="@color/color_999999"
                android:id="@+id/tvBtFsnu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                app:layout_constraintBottom_toBottomOf="@+id/tvBtFs"
                app:layout_constraintLeft_toRightOf="@+id/tvBtFs"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="@+id/tvBtFs"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <ImageView
            android:id="@+id/imgMore"
            android:background="@mipmap/icon_download_more"
            android:layout_width="5dp"
            android:layout_height="9dp"
            android:layout_marginRight="14dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
