<?xml version="1.0" encoding="utf-8"?>
<com.zhy.autolayout.AutoFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.zhy.autolayout.AutoLinearLayout
        android:orientation="vertical"
        android:background="@drawable/bg_standard_dialog"
        android:paddingBottom="60px"
        android:layout_width="600px"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="36px"
            android:textColor="@color/color_1a1a1a"
            android:layout_gravity="center"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="70px"/>
        <TextView
            android:textSize="26px"
            android:textColor="@color/color_333333"
            android:gravity="left"
            android:id="@+id/mTip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="41px"
            android:layout_marginTop="60px"
            android:layout_marginRight="41px"/>
        <TextView
            android:textSize="32px"
            android:textColor="@color/color_ffffff"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/mOk"
            android:background="@drawable/shape_green_radius_solid"
            android:layout_width="480px"
            android:layout_height="90px"
            android:layout_marginTop="54px"
            android:text="@string/hint_dialog_button_know"/>
    </com.zhy.autolayout.AutoLinearLayout>
</com.zhy.autolayout.AutoFrameLayout>
