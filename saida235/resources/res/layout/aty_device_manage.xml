<?xml version="1.0" encoding="utf-8"?>
<com.zhy.autolayout.AutoLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/mAllRoot"
    android:background="@color/color_FF292A30"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.mobile.brasiltv.view.TitleBarView
        android:id="@+id/mTbvTitle"
        android:layout_width="match_parent"
        android:layout_height="88px"
        app:compatBarHeight="false"
        app:titleText="@string/dm_title"
        app:titleTextColor="@color/white"/>
    <TextView
        android:textSize="32px"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/mTvDesc"
        android:background="@color/color_bg"
        android:paddingLeft="30px"
        android:paddingTop="56px"
        android:paddingRight="30px"
        android:paddingBottom="56px"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/dm_hint"/>
    <com.zhy.autolayout.AutoFrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/mRvDevice"
            android:background="@color/color_bg"
            android:paddingLeft="18px"
            android:paddingRight="18px"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <com.mobile.brasiltv.view.CustomEmptyView
            android:id="@+id/mKevLoading"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:bgColor="@color/transparent"
            app:emptyShowType="loading"/>
        <com.zhy.autolayout.AutoLinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/mAllException"
            android:background="@color/color_bg"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ImageView
                android:layout_width="252px"
                android:layout_height="196px"
                android:src="@drawable/ic_status_exception"
                android:scaleType="fitXY"/>
            <TextView
                android:textSize="28px"
                android:textColor="@color/color_6A6D74"
                android:gravity="center"
                android:paddingLeft="40px"
                android:paddingRight="40px"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="40px"
                android:scaleType="fitXY"
                android:text="@string/exception_status"/>
        </com.zhy.autolayout.AutoLinearLayout>
    </com.zhy.autolayout.AutoFrameLayout>
    <TextView
        android:textSize="24px"
        android:textColor="@color/color_6A6D74"
        android:gravity="center"
        android:id="@+id/mTvHint"
        android:background="@color/color_bg"
        android:padding="30px"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/dm_desc"/>
    <com.zhy.autolayout.AutoFrameLayout
        android:id="@+id/mAflMenu"
        android:background="@color/color_FF292A30"
        android:layout_width="match_parent"
        android:layout_height="136px">
        <TextView
            android:textSize="28px"
            android:textColor="@color/white"
            android:gravity="center_vertical"
            android:id="@+id/mTvSelectAll"
            android:paddingLeft="104px"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/dm_select_all"/>
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/mIvSelect"
            android:layout_width="32px"
            android:layout_height="32px"
            android:layout_marginLeft="56px"
            android:src="@drawable/bg_single_select"/>
        <TextView
            android:textSize="28px"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/mTvKickOutDevice"
            android:background="@drawable/bg_filter_cond"
            android:layout_width="248px"
            android:layout_height="72px"
            android:layout_marginRight="28px"
            android:text="@string/dm_remove"/>
    </com.zhy.autolayout.AutoFrameLayout>
</com.zhy.autolayout.AutoLinearLayout>
