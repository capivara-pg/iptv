<?xml version="1.0" encoding="utf-8"?>
<com.zhy.autolayout.AutoFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mAccountBindRoot"
    android:background="@color/color_20202a"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.mobile.brasiltv.view.TitleBarView
        android:id="@+id/mTbvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:titleBgColor="@color/color_292A30"
        app:titleText="@string/binding_account"
        app:titleTextColor="@color/color_ffffff"/>
    <com.zhy.autolayout.AutoLinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="175px">
        <com.zhy.autolayout.AutoLinearLayout
            android:orientation="horizontal"
            android:background="@color/color_292A30"
            android:layout_width="match_parent"
            android:layout_height="112px">
            <View
                android:layout_gravity="center_vertical"
                android:background="@drawable/ic_login_google"
                android:layout_width="56px"
                android:layout_height="56px"
                android:layout_marginLeft="32px"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/white"
                android:layout_gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="18px"
                android:text="@string/account_bind_google"
                android:layout_weight="1"/>
            <TextView
                android:textSize="28px"
                android:textColor="@color/ffffff"
                android:gravity="center"
                android:layout_gravity="center_vertical"
                android:id="@+id/mLbGoogleBind"
                android:background="@drawable/bg_3cd977_8_radius"
                android:layout_width="160px"
                android:layout_height="64px"
                android:layout_marginRight="32px"
                android:text="@string/account_bind_dialog_bt"/>
        </com.zhy.autolayout.AutoLinearLayout>
        <com.zhy.autolayout.AutoLinearLayout
            android:orientation="horizontal"
            android:background="@color/color_292A30"
            android:layout_width="match_parent"
            android:layout_height="110px"
            android:layout_marginTop="1px">
            <View
                android:layout_gravity="center_vertical"
                android:background="@drawable/icon_account_bind_email"
                android:layout_width="56px"
                android:layout_height="56px"
                android:layout_marginLeft="32px"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/white"
                android:layout_gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="18px"
                android:text="@string/account_bind_mail"
                android:layout_weight="1"/>
            <TextView
                android:textSize="28px"
                android:textColor="@color/ffffff"
                android:gravity="center"
                android:layout_gravity="center_vertical"
                android:id="@+id/mLbEmailBind"
                android:background="@drawable/bg_3cd977_8_radius"
                android:layout_width="160px"
                android:layout_height="64px"
                android:layout_marginRight="32px"
                android:text="@string/account_bind_dialog_bt"/>
        </com.zhy.autolayout.AutoLinearLayout>
        <com.zhy.autolayout.AutoLinearLayout
            android:orientation="horizontal"
            android:background="@color/color_292A30"
            android:layout_width="match_parent"
            android:layout_height="110px"
            android:layout_marginTop="1px">
            <View
                android:layout_gravity="center_vertical"
                android:background="@drawable/icon_account_bind_mobile"
                android:layout_width="56px"
                android:layout_height="56px"
                android:layout_marginLeft="32px"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/white"
                android:layout_gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="18px"
                android:text="@string/account_bind_phone"
                android:layout_weight="1"/>
            <TextView
                android:textSize="28px"
                android:textColor="@color/ffffff"
                android:gravity="center"
                android:layout_gravity="center_vertical"
                android:id="@+id/mLbMobileBind"
                android:background="@drawable/bg_3cd977_8_radius"
                android:layout_width="160px"
                android:layout_height="64px"
                android:layout_marginRight="32px"
                android:text="@string/account_bind_dialog_bt"/>
        </com.zhy.autolayout.AutoLinearLayout>
        <TextView
            android:textSize="24px"
            android:textColor="@color/color_fe9732"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="32px"
            android:layout_marginTop="48px"
            android:layout_marginRight="32px"
            android:text="@string/account_bind_tips"/>
    </com.zhy.autolayout.AutoLinearLayout>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/color_e6e6e6"
        android:gravity="center"
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/mTvPrivacyPolicy"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="55px"/>
</com.zhy.autolayout.AutoFrameLayout>
