<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/iv_checkbox"
        android:visibility="gone"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="18dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.mobile.videodownloads.view.AutoCardView
        android:orientation="vertical"
        android:id="@+id/mLayout"
        android:layout_width="73dp"
        android:layout_height="105dp"
        android:layout_marginTop="5dp"
        android:foreground="?android:attr/selectableItemBackground"
        android:layout_marginStart="15dp"
        app:cardCornerRadius="3dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/iv_checkbox"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/posterImageView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/special_cloumn_img_placeholder"
            android:scaleType="centerCrop"/>
    </com.mobile.videodownloads.view.AutoCardView>
    <TextView
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/color_ffffff"
        android:ellipsize="end"
        android:id="@+id/mTvName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:maxLines="2"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="10dp"
        app:layout_constraintLeft_toRightOf="@+id/mLayout"
        app:layout_constraintRight_toLeftOf="@+id/imgBack"
        app:layout_constraintTop_toTopOf="@+id/mLayout"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/color_e6e6e6"
        android:id="@+id/tvEpisode"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:text=""
        app:layout_constraintLeft_toLeftOf="@+id/mTvName"
        app:layout_constraintTop_toBottomOf="@+id/mTvName"/>
    <ImageView
        android:id="@+id/imgBack"
        android:background="@mipmap/icon_download_next"
        android:visibility="visible"
        android:layout_width="7dp"
        android:layout_height="13dp"
        android:layout_marginEnd="15dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
