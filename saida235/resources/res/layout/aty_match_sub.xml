<?xml version="1.0" encoding="utf-8"?>
<com.zhy.autolayout.AutoLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/color_FF292A30"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.zhy.autolayout.AutoFrameLayout
        android:id="@+id/mFlTitle"
        android:background="@color/color_FF292A30"
        android:layout_width="match_parent"
        android:layout_height="88px">
        <ImageView
            android:layout_gravity="bottom"
            android:id="@+id/mIvBack"
            android:paddingLeft="32px"
            android:paddingTop="28px"
            android:paddingRight="32px"
            android:paddingBottom="28px"
            android:layout_width="88px"
            android:layout_height="match_parent"
            android:src="@drawable/icon_title_back"
            android:scaleType="fitCenter"/>
        <TextView
            android:textSize="36px"
            android:textStyle="bold"
            android:textColor="@color/ffffff"
            android:gravity="center"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/match_my_sub"/>
    </com.zhy.autolayout.AutoFrameLayout>
    <com.zhy.autolayout.AutoFrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/mRvSub"
            android:background="@color/color_FF1C1D23"
            android:paddingTop="16px"
            android:paddingBottom="16px"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <com.zhy.autolayout.AutoLinearLayout
            android:gravity="center_horizontal"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:id="@+id/llEmpty"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="60px">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/ivEmpty"
                android:layout_width="320px"
                android:layout_height="320px"
                android:src="@drawable/icon_without_subscribe"/>
            <TextView
                android:textSize="24px"
                android:textColor="@color/color_FF79797F"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20px"
                android:text="@string/match_you_have_not_suscribe_match"/>
        </com.zhy.autolayout.AutoLinearLayout>
    </com.zhy.autolayout.AutoFrameLayout>
</com.zhy.autolayout.AutoLinearLayout>
