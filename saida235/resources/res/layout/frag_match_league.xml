<?xml version="1.0" encoding="utf-8"?>
<com.zhy.autolayout.AutoLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.zhy.autolayout.AutoFrameLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="132px">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvLeague"
            android:paddingTop="42px"
            android:layout_width="match_parent"
            android:layout_height="132px"
            android:layout_marginRight="104px"/>
        <com.zhy.autolayout.AutoFrameLayout
            android:layout_gravity="end|center_vertical"
            android:id="@+id/flMenu"
            android:background="@mipmap/bg_match_league_menu"
            android:layout_width="110px"
            android:layout_height="104px"
            android:layout_marginTop="10px">
            <ImageView
                android:layout_gravity="center"
                android:layout_width="52px"
                android:layout_height="52px"
                android:layout_marginLeft="4px"
                android:src="@mipmap/icon_match_league_menu"/>
        </com.zhy.autolayout.AutoFrameLayout>
    </com.zhy.autolayout.AutoFrameLayout>
    <com.zhy.autolayout.AutoRelativeLayout
        android:id="@+id/mLayoutViewPager"
        android:background="@color/color_191a23"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.viewpager.widget.ViewPager
            android:id="@+id/matchViewPager"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <com.zhy.autolayout.AutoLinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/llEmpty"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="60px"
            android:layout_centerInParent="true">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/ivEmpty"
                android:layout_width="320px"
                android:layout_height="320px"
                android:src="@mipmap/icon_match_list_empty"/>
            <TextView
                android:textSize="24px"
                android:textColor="@color/color_FF79797F"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20px"
                android:text="@string/match_have_no_data"/>
        </com.zhy.autolayout.AutoLinearLayout>
    </com.zhy.autolayout.AutoRelativeLayout>
</com.zhy.autolayout.AutoLinearLayout>
