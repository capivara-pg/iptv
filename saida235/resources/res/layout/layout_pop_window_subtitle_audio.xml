<?xml version="1.0" encoding="utf-8"?>
<com.zhy.autolayout.AutoRelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mPopController"
    android:background="@drawable/bg_fullscreen_function_shadow"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="18sp"
        android:textColor="@color/color_important_white"
        android:id="@+id/mTvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20px"
        android:layout_marginTop="100px"
        android:text="@string/play_selete_pisode"/>
    <ImageView
        android:id="@+id/ivClose"
        android:padding="14px"
        android:layout_width="56px"
        android:layout_height="56px"
        android:layout_marginTop="100px"
        android:layout_marginRight="10px"
        android:src="@mipmap/close"
        android:layout_alignParentRight="true"/>
    <com.zhy.autolayout.AutoLinearLayout
        android:orientation="vertical"
        android:id="@+id/mLlAudio"
        android:layout_width="320px"
        android:layout_height="wrap_content"
        android:layout_marginLeft="24px"
        android:layout_marginTop="36px"
        android:layout_below="@+id/mTvTitle">
        <TextView
            android:textSize="36px"
            android:textColor="@color/color_important_white"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="1px"
            android:text="@string/vod_audio"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/mRvAudio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="54px"/>
    </com.zhy.autolayout.AutoLinearLayout>
    <com.zhy.autolayout.AutoLinearLayout
        android:orientation="vertical"
        android:id="@+id/mLlSubtitle"
        android:layout_width="280px"
        android:layout_height="wrap_content"
        android:layout_marginTop="36px"
        android:layout_toRightOf="@+id/mLlAudio"
        android:layout_below="@+id/mTvTitle">
        <TextView
            android:textSize="36px"
            android:textColor="@color/color_important_white"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="1px"
            android:text="@string/subtitle_dialog_setting"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/mRvLanguage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="54px"/>
    </com.zhy.autolayout.AutoLinearLayout>
    <com.zhy.autolayout.AutoLinearLayout
        android:orientation="vertical"
        android:id="@+id/mLlSubtitleTime"
        android:layout_width="280px"
        android:layout_height="wrap_content"
        android:layout_marginTop="36px"
        android:layout_toRightOf="@+id/mLlSubtitle"
        android:layout_below="@+id/mTvTitle">
        <TextView
            android:textSize="36px"
            android:textColor="@color/color_important_white"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="1px"
            android:text="@string/subtitle_time"/>
        <LinearLayout
            android:layout_gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="13dp">
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/ivForward"
                android:padding="5dp"
                android:nextFocusLeft="@+id/ivForward"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginRight="10dp"
                android:src="@mipmap/icon_subtitle_time_forward"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/tvTime"
                android:background="@drawable/shape_bg_subtitle_time_focus"
                android:layout_width="52dp"
                android:layout_height="24dp"/>
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/ivBack"
                android:padding="5dp"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginLeft="10dp"
                android:src="@mipmap/icon_subtitle_time_back"/>
        </LinearLayout>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/color_ffffff"
            android:gravity="center"
            android:id="@+id/tvReset"
            android:background="@drawable/shape_bg_subtitle_time_reset_focus"
            android:nextFocusRight="@+id/tvReset"
            android:layout_width="75dp"
            android:layout_height="25dp"
            android:layout_marginLeft="30dp"
            android:layout_marginTop="16dp"
            android:text="@string/reset"/>
    </com.zhy.autolayout.AutoLinearLayout>
    <com.zhy.autolayout.AutoLinearLayout
        android:orientation="vertical"
        android:id="@+id/mLlLandSize"
        android:visibility="gone"
        android:layout_width="280px"
        android:layout_height="wrap_content"
        android:layout_marginTop="36px"
        android:layout_toRightOf="@+id/mLlSubtitleTime"
        android:layout_below="@+id/mTvTitle">
        <TextView
            android:textSize="36px"
            android:textColor="@color/color_important_white"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="1px"
            android:text="@string/size"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/mRvSize"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="54px"/>
    </com.zhy.autolayout.AutoLinearLayout>
    <com.zhy.autolayout.AutoLinearLayout
        android:orientation="vertical"
        android:id="@+id/mLlLandStyle"
        android:visibility="gone"
        android:layout_width="280px"
        android:layout_height="wrap_content"
        android:layout_marginTop="36px"
        android:layout_toRightOf="@+id/mLlLandSize"
        android:layout_below="@+id/mTvTitle">
        <TextView
            android:textSize="36px"
            android:textColor="@color/color_important_white"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="1px"
            android:text="@string/style"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/mRvColor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="54px"/>
    </com.zhy.autolayout.AutoLinearLayout>
</com.zhy.autolayout.AutoRelativeLayout>
