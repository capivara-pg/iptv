<?xml version="1.0" encoding="utf-8"?>
<com.mobile.brasiltv.view.AutoHideRelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mLiveControlPanelPortrait"
    android:background="@drawable/bg_play_fullscreen_shadow"
    android:visibility="visible"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.zhy.autolayout.AutoRelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.zhy.autolayout.AutoLinearLayout
            android:orientation="horizontal"
            android:id="@+id/llMenu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true">
            <ImageView
                android:id="@+id/mDebugSwitch"
                android:visibility="gone"
                android:layout_width="40px"
                android:layout_height="40px"
                android:layout_marginTop="30px"
                android:layout_marginRight="25px"
                android:src="@mipmap/close"
                android:scaleType="fitCenter"/>
            <ImageView
                android:id="@+id/mImageShare"
                android:layout_width="48px"
                android:layout_height="48px"
                android:layout_marginTop="24px"
                android:layout_marginRight="50px"
                android:src="@drawable/ic_play_menu_share"
                android:scaleType="fitCenter"/>
            <ImageView
                android:id="@+id/mImageFeedback"
                android:layout_width="48px"
                android:layout_height="48px"
                android:layout_marginTop="24px"
                android:layout_marginRight="50px"
                android:src="@drawable/ic_feedback"/>
            <ImageView
                android:id="@+id/mIvPortQuality"
                android:visibility="gone"
                android:layout_width="48px"
                android:layout_height="48px"
                android:layout_marginTop="24px"
                android:layout_marginRight="50px"
                android:src="@drawable/ic_quality_480p"/>
            <ImageView
                android:id="@+id/mIvFavPort"
                android:layout_width="48px"
                android:layout_height="48px"
                android:layout_marginTop="24px"
                android:layout_marginRight="50px"
                android:src="@drawable/ic_live_not_fav"/>
            <ImageView
                android:id="@+id/mIconCastPort"
                android:visibility="gone"
                android:layout_width="48px"
                android:layout_height="48px"
                android:layout_marginTop="24px"
                android:layout_marginRight="38px"
                android:src="@drawable/icon_cast"/>
        </com.zhy.autolayout.AutoLinearLayout>
        <ImageView
            android:id="@+id/mIconSilence"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="48px"
            android:layout_height="48px"
            android:layout_marginLeft="15px"
            android:layout_marginBottom="15px"
            android:src="@drawable/ic_live_volume_on"
            android:layout_alignParentBottom="true"/>
        <ImageView
            android:id="@+id/mIconFullscreen"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="48px"
            android:layout_height="48px"
            android:layout_marginRight="15px"
            android:layout_marginBottom="15px"
            android:src="@drawable/ic_live_fullscreen"
            android:layout_alignParentRight="true"
            android:layout_alignParentBottom="true"/>
    </com.zhy.autolayout.AutoRelativeLayout>
</com.mobile.brasiltv.view.AutoHideRelativeLayout>
