<?xml version="1.0" encoding="utf-8"?>
<com.zhy.autolayout.AutoFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/black"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:keepScreenOn="true">
    <com.zhy.autolayout.AutoLinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/mLlDefaultPage"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/mIvDefaultPage"
            android:layout_width="400px"
            android:layout_height="400px"
            android:src="@drawable/icon_default_page_short_column"/>
        <TextView
            android:textSize="28px"
            android:textColor="@color/color_FFFEFE"
            android:gravity="center"
            android:id="@+id/mTvDefaultPage"
            android:paddingLeft="128px"
            android:paddingRight="128px"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="48px"
            android:text="@string/short_error_get_column_fail"/>
    </com.zhy.autolayout.AutoLinearLayout>
    <com.airbnb.lottie.LottieAnimationView
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/mAvLoadingMore"
        android:visibility="gone"
        android:layout_width="96px"
        android:layout_height="96px"
        android:layout_marginBottom="12px"
        app:lottie_autoPlay="true"
        app:lottie_loop="true"
        app:lottie_rawRes="@raw/animation_loading_more"/>
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/mViewPager2"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <androidx.recyclerview.widget.RecyclerView
        android:layout_gravity="center_horizontal"
        android:id="@+id/mRvColumn"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="52px"
        android:layout_marginTop="110px"/>
    <ImageView
        android:id="@+id/mIvBack"
        android:visibility="gone"
        android:layout_width="48px"
        android:layout_height="48px"
        android:layout_marginLeft="32px"
        android:layout_marginTop="108px"
        android:src="@drawable/icon_back_arrow"
        android:scaleType="fitCenter"
        android:elevation="4px"/>
    <ImageView
        android:layout_gravity="top|left"
        android:id="@+id/mIvSearch"
        android:visibility="gone"
        android:layout_width="48px"
        android:layout_height="48px"
        android:layout_marginLeft="32px"
        android:layout_marginTop="108px"
        android:src="@drawable/icon_short_search"
        android:scaleType="fitCenter"
        android:elevation="4px"/>
    <TextView
        android:textColor="@color/color_ffffff"
        android:gravity="center"
        android:id="@+id/mTvStopCast"
        android:background="@color/color_000000"
        android:padding="32px"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:text="@string/short_tip_casting"/>
</com.zhy.autolayout.AutoFrameLayout>
