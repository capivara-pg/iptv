<?xml version="1.0" encoding="utf-8"?>
<com.zhy.autolayout.AutoFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/mFlMatchChannel"
    android:background="@drawable/bg_match_channel_selected"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginLeft="24px"
    android:layout_marginTop="10px">
    <com.zhy.autolayout.AutoFrameLayout
        android:layout_width="248px"
        android:layout_height="110px">
        <com.airbnb.lottie.LottieAnimationView
            android:layout_gravity="top|right"
            android:id="@+id/mLottiePlaying"
            android:layout_width="22px"
            android:layout_height="22px"
            android:layout_marginTop="16px"
            android:layout_marginRight="26px"
            app:lottie_autoPlay="true"
            app:lottie_loop="true"
            app:lottie_rawRes="@raw/match_channel_playing"/>
        <TextView
            android:textSize="24px"
            android:textColor="@color/color_important_white"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/mTvChannelName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="32px"
            android:layout_marginTop="38px"
            android:layout_marginRight="32px"
            android:singleLine="true"/>
        <TextView
            android:textSize="20px"
            android:textColor="@color/color_AEAFB3"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:layout_gravity="bottom"
            android:id="@+id/mTvCountry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="32px"
            android:layout_marginRight="32px"
            android:layout_marginBottom="10px"
            android:singleLine="true"/>
    </com.zhy.autolayout.AutoFrameLayout>
</com.zhy.autolayout.AutoFrameLayout>
