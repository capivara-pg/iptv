<?xml version="1.0" encoding="utf-8"?>
<com.zhy.autolayout.AutoFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.zhy.autolayout.AutoLinearLayout
        android:orientation="vertical"
        android:background="@drawable/bg_standard_back"
        android:paddingBottom="64px"
        android:layout_width="622px"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="bottom|center_horizontal"
            android:id="@+id/mTvTitle"
            android:background="@drawable/bg_register_success_title"
            android:layout_width="match_parent"
            android:layout_height="180px"
            android:text="@string/registration_successful"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/color_8d8e91"
            android:gravity="center"
            android:id="@+id/mTvMessage"
            android:layout_width="match_parent"
            android:layout_height="0px"
            android:layout_marginLeft="48px"
            android:layout_marginTop="20px"
            android:layout_marginRight="48px"
            android:layout_weight="1"/>
        <TextView
            android:textSize="15sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/mTvConfirm"
            android:background="@drawable/bg_standard_submit"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="88px"
            android:layout_marginLeft="90px"
            android:layout_marginTop="48px"
            android:layout_marginRight="90px"
            android:text="@string/confirm"/>
    </com.zhy.autolayout.AutoLinearLayout>
</com.zhy.autolayout.AutoFrameLayout>
