<?xml version="1.0" encoding="utf-8"?>
<com.zhy.autolayout.AutoLinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.zhy.autolayout.AutoRelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/ivTitleIcon"
            android:layout_width="48px"
            android:layout_height="48px"
            android:layout_marginLeft="30px"
            android:layout_marginTop="50px"
            android:layout_marginBottom="16px"
            android:layout_alignParentLeft="true"
            android:layout_alignParentTop="true"/>
        <TextView
            android:textSize="36px"
            android:textStyle="bold"
            android:textColor="@color/ffffff"
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20px"
            android:layout_marginTop="50px"
            android:layout_marginBottom="16px"
            android:layout_toRightOf="@+id/ivTitleIcon"/>
        <TextView
            android:textSize="28px"
            android:textColor="@color/color_important"
            android:gravity="center"
            android:id="@+id/tvGo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="30px"
            android:text="@string/see_all"
            android:layout_alignTop="@+id/tvTitle"
            android:layout_alignBottom="@+id/tvTitle"
            android:layout_alignParentRight="true"/>
    </com.zhy.autolayout.AutoRelativeLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMatchList"
        android:paddingLeft="16px"
        android:paddingRight="16px"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="232px"/>
    <com.zhy.autolayout.AutoFrameLayout
        android:id="@+id/flEmptyMatch"
        android:background="@drawable/bg_home_match_empty"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="232px"
        android:layout_marginLeft="30px"
        android:layout_marginRight="30px">
        <com.zhy.autolayout.AutoLinearLayout
            android:gravity="center_vertical"
            android:layout_gravity="end|center_vertical"
            android:orientation="horizontal"
            android:id="@+id/llMatchEnter"
            android:background="@drawable/bg_home_match_empty_more"
            android:layout_width="214px"
            android:layout_height="60px"
            android:layout_marginEnd="80px">
            <TextView
                android:textSize="20px"
                android:textColor="@color/ffffff"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="74px"
                android:text="@string/home_match_empty_more"/>
            <ImageView
                android:layout_width="30px"
                android:layout_height="30px"
                android:layout_marginLeft="20px"
                android:src="@mipmap/ic_match_enter_arrow"/>
        </com.zhy.autolayout.AutoLinearLayout>
    </com.zhy.autolayout.AutoFrameLayout>
</com.zhy.autolayout.AutoLinearLayout>
