<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/color_000000"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:background="@drawable/shortvideo_shadow_up"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <ImageView
        android:layout_gravity="bottom"
        android:background="@drawable/shortvideo_shadow_down"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <ImageView
        android:id="@+id/mIvPoster"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/mIvPlay"
        android:visibility="gone"
        android:layout_width="108px"
        android:layout_height="108px"
        android:src="@drawable/icon_short_video_pause"
        android:scaleType="fitCenter"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/mAvLoading"
        android:visibility="gone"
        android:layout_width="96px"
        android:layout_height="96px"
        android:src="@drawable/animation_center_buffer_loading"
        android:scaleType="fitXY"/>
    <com.zhy.autolayout.AutoRelativeLayout
        android:layout_gravity="bottom|right"
        android:id="@+id/mLlFunction"
        android:layout_width="96px"
        android:layout_height="600px"
        android:layout_marginRight="20px"
        android:layout_marginBottom="96px">
        <ImageView
            android:id="@+id/mIvThumbsUp"
            android:layout_width="96px"
            android:layout_height="96px"
            android:src="@drawable/icon_thumbs_up_normal"
            android:scaleType="fitCenter"
            android:layout_alignParentLeft="true"
            android:layout_alignParentTop="true"
            android:layout_alignParentRight="true"/>
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/mAvThumbsUp"
            android:visibility="gone"
            android:layout_width="96px"
            android:layout_height="96px"
            android:layout_alignLeft="@+id/mIvThumbsUp"
            android:layout_alignTop="@+id/mIvThumbsUp"
            android:layout_alignRight="@+id/mIvThumbsUp"
            android:layout_alignBottom="@+id/mIvThumbsUp"
            app:lottie_autoPlay="false"
            app:lottie_loop="false"
            app:lottie_rawRes="@raw/animation_like"/>
        <TextView
            android:textSize="20px"
            android:textColor="@color/color_FFFEFE"
            android:gravity="top|center_horizontal"
            android:id="@+id/mTvLikedNum"
            android:paddingTop="5px"
            android:layout_width="96px"
            android:layout_height="54px"
            android:layout_below="@+id/mIvThumbsUp"
            android:layout_alignParentLeft="true"
            android:layout_alignParentRight="true"/>
        <ImageView
            android:id="@+id/mIvFavorite"
            android:layout_width="96px"
            android:layout_height="96px"
            android:src="@drawable/icon_favorite_normal"
            android:scaleType="fitCenter"
            android:layout_below="@+id/mTvLikedNum"
            android:layout_alignParentLeft="true"
            android:layout_alignParentRight="true"/>
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/mAvFavorite"
            android:visibility="gone"
            android:layout_width="96px"
            android:layout_height="96px"
            android:layout_alignLeft="@+id/mIvFavorite"
            android:layout_alignTop="@+id/mIvFavorite"
            android:layout_alignRight="@+id/mIvFavorite"
            android:layout_alignBottom="@+id/mIvFavorite"
            app:lottie_autoPlay="false"
            app:lottie_loop="false"
            app:lottie_rawRes="@raw/animation_favorite"/>
        <TextView
            android:textSize="20px"
            android:textColor="@color/color_FFFEFE"
            android:gravity="top|center_horizontal"
            android:id="@+id/mTvFavorite"
            android:paddingTop="5px"
            android:layout_width="96px"
            android:layout_height="54px"
            android:text="@string/fun_favorite"
            android:layout_below="@+id/mIvFavorite"
            android:layout_alignParentLeft="true"
            android:layout_alignParentRight="true"/>
        <ImageView
            android:id="@+id/mIvShare"
            android:layout_width="96px"
            android:layout_height="96px"
            android:src="@drawable/icon_share"
            android:scaleType="fitCenter"
            android:layout_below="@+id/mTvFavorite"
            android:layout_alignParentLeft="true"
            android:layout_alignParentRight="true"/>
        <TextView
            android:textSize="20px"
            android:textColor="@color/color_FFFEFE"
            android:gravity="top|center_horizontal"
            android:id="@+id/mTvShare"
            android:paddingTop="5px"
            android:layout_width="96px"
            android:layout_height="54px"
            android:text="@string/fun_share"
            android:layout_below="@+id/mIvShare"
            android:layout_alignParentLeft="true"
            android:layout_alignParentRight="true"/>
        <ImageView
            android:id="@+id/mIvFeedback"
            android:layout_width="96px"
            android:layout_height="96px"
            android:src="@drawable/icon_feedback"
            android:scaleType="fitCenter"
            android:layout_below="@+id/mTvShare"
            android:layout_alignParentLeft="true"
            android:layout_alignParentRight="true"/>
        <TextView
            android:textSize="20px"
            android:textColor="@color/color_FFFEFE"
            android:gravity="top|center_horizontal"
            android:paddingTop="5px"
            android:layout_width="96px"
            android:layout_height="54px"
            android:text="@string/fun_feedback"
            android:layout_below="@+id/mIvFeedback"
            android:layout_alignParentLeft="true"
            android:layout_alignParentRight="true"/>
    </com.zhy.autolayout.AutoRelativeLayout>
    <com.zhy.autolayout.AutoFrameLayout
        android:layout_gravity="bottom"
        android:id="@+id/mFlPortraitSeekBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_gravity="bottom"
            android:id="@+id/mIvBuffer"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="20px"
            android:layout_marginLeft="8px"
            android:layout_marginRight="8px"
            android:src="@drawable/animation_buffer_loading"
            android:scaleType="fitXY"/>
        <com.shortvideo.view.ShortVideoSeekBar
            android:layout_gravity="bottom"
            android:id="@+id/mShortVideoSeekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </com.zhy.autolayout.AutoFrameLayout>
    <com.zhy.autolayout.AutoLinearLayout
        android:gravity="bottom"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:id="@+id/mLlPortrait"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="52px">
        <com.zhy.autolayout.AutoRelativeLayout
            android:id="@+id/mReWatch"
            android:background="@drawable/bg_watch"
            android:layout_width="172dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="30px"
            android:layout_marginBottom="8px">
            <com.shortvideo.view.AutoCardView
                android:id="@+id/mCardWatch"
                android:layout_width="48dp"
                android:layout_height="66dp"
                android:layout_margin="8px"
                app:cardCornerRadius="4px">
                <ImageView
                    android:id="@+id/mImgWatch"
                    android:layout_width="48dp"
                    android:layout_height="66dp"
                    android:scaleType="fitXY"/>
            </com.shortvideo.view.AutoCardView>
            <TextView
                android:textSize="10sp"
                android:textColor="@color/white"
                android:ellipsize="end"
                android:id="@+id/mTvContent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_marginTop="28px"
                android:text=""
                android:maxLines="1"
                android:layout_toRightOf="@+id/mCardWatch"
                android:layout_alignTop="@+id/mCardWatch"/>
            <TextView
                android:textSize="9sp"
                android:textColor="@color/color_FFFEFE"
                android:gravity="center_vertical"
                android:layout_gravity="bottom"
                android:id="@+id/mTvWatchContent"
                android:background="@drawable/shape_bg_watch_mob_content"
                android:paddingLeft="5dp"
                android:paddingRight="16px"
                android:visibility="visible"
                android:layout_width="97dp"
                android:layout_height="20dp"
                android:layout_marginLeft="5dp"
                android:layout_marginBottom="20px"
                android:minWidth="112dp"
                android:text="@string/watch_all"
                android:drawableLeft="@drawable/icon_full_stop"
                android:drawableRight="@drawable/icon_watch_back"
                android:drawablePadding="8px"
                android:layout_toRightOf="@+id/mCardWatch"
                android:layout_alignBottom="@+id/mCardWatch"/>
        </com.zhy.autolayout.AutoRelativeLayout>
        <TextView
            android:textSize="28px"
            android:textColor="@color/color_FFFEFE"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/mTvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="32px"
            android:layout_marginBottom="8px"
            android:maxWidth="600px"
            android:text="The Fall Guy Highlights The Fall Guy Highlights Xxxxxx abcdefghijklmn opqrstuvwxyz"
            android:maxLines="1"/>
        <com.shortvideo.view.expandable.ExpandableTextView
            android:textSize="24px"
            android:textColor="@color/color_B3FFFEFE"
            android:layout_gravity="bottom"
            android:id="@+id/mTvDetail"
            android:layout_width="600px"
            android:layout_height="wrap_content"
            android:layout_marginLeft="32px"
            android:shadowColor="@color/color_33000000"
            android:shadowDy="2"
            android:shadowRadius="2"
            android:lineSpacingExtra="4dp"
            app:ep_contract_color="@color/color_ffffff"
            app:ep_expand_color="@color/color_ffffff"
            app:ep_max_line="1"
            app:ep_need_contract="true"
            app:ep_need_expand="true"
            app:ep_need_link="false"
            app:ep_need_mention="false"/>
    </com.zhy.autolayout.AutoLinearLayout>
    <TextView
        android:textSize="20px"
        android:textColor="@color/color_ffffff"
        android:gravity="center"
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/mTvFullScreen"
        android:background="@drawable/shape_bg_full_screen_button"
        android:paddingLeft="20px"
        android:paddingRight="20px"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="190px"
        android:layout_height="56px"
        android:layout_marginBottom="392px"
        android:text="@string/full_screen"
        android:drawableLeft="@drawable/icon_full_back"/>
    <com.shortvideo.view.AlphaFrameLayout
        android:id="@+id/mFlFullScreen"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/mIvFullBack"
            android:layout_width="56px"
            android:layout_height="56px"
            android:layout_marginLeft="40px"
            android:layout_marginTop="50px"
            android:src="@drawable/icon_back_arrow"
            android:scaleType="fitCenter"/>
        <TextView
            android:textSize="32px"
            android:textColor="@color/color_FFFEFE"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/mTvFullTitle"
            android:layout_width="wrap_content"
            android:layout_height="46px"
            android:layout_marginLeft="106px"
            android:layout_marginTop="54px"
            android:maxWidth="1200px"
            android:text="The Fall Guy Highlights The Fall Guy Highlights Xxxxxx abcdefghijklmn opqrstuvwxyz"
            android:singleLine="true"/>
        <SeekBar
            android:layout_gravity="bottom|center_horizontal"
            android:id="@+id/mFullSeekBar"
            android:layout_width="1500px"
            android:layout_height="40px"
            android:layout_marginBottom="176px"
            android:maxHeight="8px"
            android:progress="0"
            android:progressDrawable="@drawable/seekbar_full"
            android:minHeight="8px"
            android:thumb="@drawable/shape_seek_bar_thumb_full"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/mIvFullPlay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/icon_full_pause"/>
        <TextView
            android:textSize="28px"
            android:textColor="@color/color_ffffff"
            android:gravity="center"
            android:layout_gravity="bottom|left"
            android:id="@+id/mTvCurTime"
            android:layout_width="152px"
            android:layout_height="40px"
            android:layout_marginLeft="44px"
            android:layout_marginBottom="230px"/>
        <TextView
            android:textSize="28px"
            android:textColor="@color/color_80FFFFFF"
            android:gravity="center_vertical"
            android:layout_gravity="bottom|left"
            android:id="@+id/mTvTotalTime"
            android:layout_width="wrap_content"
            android:layout_height="40px"
            android:layout_marginLeft="200px"
            android:layout_marginBottom="230px"/>
        <TextView
            android:textSize="24px"
            android:textColor="@color/color_FFFEFE"
            android:gravity="center_vertical"
            android:layout_gravity="bottom|right"
            android:id="@+id/mTvFullWatchContent"
            android:background="@drawable/shape_bg_watch_mob_content"
            android:paddingLeft="16px"
            android:paddingRight="16px"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="64px"
            android:layout_marginRight="80px"
            android:layout_marginBottom="86px"
            android:minWidth="296px"
            android:text="@string/watch_content"
            android:drawableLeft="@drawable/icon_watch_content_play"
            android:drawableRight="@drawable/icon_watch_back"
            android:drawablePadding="8px"/>
        <include
            android:layout_gravity="left"
            android:id="@+id/mLlBrightnessController"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="50px"
            android:layout_marginTop="120px"
            layout="@layout/layout_brightness_controller"/>
        <include
            android:layout_gravity="right"
            android:id="@+id/mLlVolumeController"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="120px"
            android:layout_marginRight="50px"
            layout="@layout/layout_volume_controller"/>
        <com.zhy.autolayout.AutoRelativeLayout
            android:layout_gravity="bottom"
            android:id="@+id/mLlFunctionFull"
            android:layout_width="600px"
            android:layout_height="130px"
            android:layout_marginLeft="70px"
            android:layout_marginBottom="50px">
            <ImageView
                android:id="@+id/mIvThumbsUpFull"
                android:layout_width="96px"
                android:layout_height="96px"
                android:src="@drawable/icon_thumbs_up_normal"
                android:scaleType="fitCenter"
                android:layout_alignParentLeft="true"
                android:layout_alignParentTop="true"/>
            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/mAvThumbsUpFull"
                android:visibility="gone"
                android:layout_width="96px"
                android:layout_height="96px"
                android:layout_alignLeft="@+id/mIvThumbsUpFull"
                android:layout_alignTop="@+id/mIvThumbsUpFull"
                android:layout_alignRight="@+id/mIvThumbsUpFull"
                android:layout_alignBottom="@+id/mIvThumbsUpFull"
                app:lottie_autoPlay="false"
                app:lottie_loop="false"
                app:lottie_rawRes="@raw/animation_like"/>
            <TextView
                android:textSize="20px"
                android:textColor="@color/color_FFFEFE"
                android:gravity="top|center_horizontal"
                android:id="@+id/mTvLikedNumFull"
                android:paddingTop="5px"
                android:layout_width="96px"
                android:layout_height="54px"
                android:layout_below="@+id/mIvThumbsUpFull"
                android:layout_alignParentLeft="true"
                android:layout_alignParentBottom="true"/>
            <ImageView
                android:id="@+id/mIvFavoriteFull"
                android:layout_width="96px"
                android:layout_height="96px"
                android:layout_marginLeft="36px"
                android:src="@drawable/icon_favorite_normal"
                android:scaleType="fitCenter"
                android:layout_toRightOf="@+id/mIvThumbsUpFull"
                android:layout_alignParentTop="true"/>
            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/mAvFavoriteFull"
                android:visibility="gone"
                android:layout_width="96px"
                android:layout_height="96px"
                android:layout_alignLeft="@+id/mIvFavoriteFull"
                android:layout_alignTop="@+id/mIvFavoriteFull"
                android:layout_alignRight="@+id/mIvFavoriteFull"
                android:layout_alignBottom="@+id/mIvFavoriteFull"
                app:lottie_autoPlay="false"
                app:lottie_loop="false"
                app:lottie_rawRes="@raw/animation_favorite"/>
            <TextView
                android:textSize="20px"
                android:textColor="@color/color_FFFEFE"
                android:gravity="top|center_horizontal"
                android:id="@+id/mTvFavoriteFull"
                android:paddingTop="5px"
                android:layout_width="96px"
                android:layout_height="54px"
                android:text="@string/fun_favorite"
                android:layout_below="@+id/mIvFavoriteFull"
                android:layout_alignLeft="@+id/mIvFavoriteFull"
                android:layout_alignRight="@+id/mIvFavoriteFull"/>
            <ImageView
                android:id="@+id/mIvShareFull"
                android:layout_width="96px"
                android:layout_height="96px"
                android:layout_marginLeft="36px"
                android:src="@drawable/icon_share"
                android:scaleType="fitCenter"
                android:layout_toRightOf="@+id/mIvFavoriteFull"
                android:layout_alignParentTop="true"/>
            <TextView
                android:textSize="20px"
                android:textColor="@color/color_FFFEFE"
                android:gravity="top|center_horizontal"
                android:id="@+id/mTvShareFull"
                android:paddingTop="5px"
                android:layout_width="96px"
                android:layout_height="54px"
                android:text="@string/fun_share"
                android:layout_below="@+id/mIvShareFull"
                android:layout_alignLeft="@+id/mIvShareFull"
                android:layout_alignRight="@+id/mIvShareFull"/>
            <ImageView
                android:id="@+id/mIvFeedbackFull"
                android:layout_width="96px"
                android:layout_height="96px"
                android:layout_marginLeft="36px"
                android:src="@drawable/icon_feedback"
                android:scaleType="fitCenter"
                android:layout_toRightOf="@+id/mIvShareFull"
                android:layout_alignParentTop="true"/>
            <TextView
                android:textSize="20px"
                android:textColor="@color/color_FFFEFE"
                android:gravity="top|center_horizontal"
                android:paddingTop="5px"
                android:layout_width="96px"
                android:layout_height="54px"
                android:text="@string/fun_feedback"
                android:layout_below="@+id/mIvFeedbackFull"
                android:layout_alignLeft="@+id/mIvFeedbackFull"
                android:layout_alignRight="@+id/mIvFeedbackFull"/>
        </com.zhy.autolayout.AutoRelativeLayout>
    </com.shortvideo.view.AlphaFrameLayout>
</merge>
