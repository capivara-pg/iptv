<?xml version="1.0" encoding="utf-8"?>
<com.zhy.autolayout.AutoRelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/color_FF31313B"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.zhy.autolayout.AutoFrameLayout
        android:id="@+id/flTitle"
        android:layout_width="match_parent"
        android:layout_height="88px"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true"
        android:layout_alignParentEnd="true">
        <ImageView
            android:id="@+id/iv_back"
            android:layout_width="48px"
            android:layout_height="48px"
            android:layout_marginLeft="32px"
            android:layout_marginTop="20px"
            android:src="@drawable/ic_column_back_white"
            android:scaleType="center"
            android:layout_alignParentLeft="true"
            android:layout_alignParentBottom="true"
            android:layout_centerVertical="true"/>
    </com.zhy.autolayout.AutoFrameLayout>
    <com.flyco.tablayout.SlidingTabLayout
        android:id="@+id/mMatchTab"
        android:layout_width="match_parent"
        android:layout_height="70px"
        android:layout_below="@+id/flTitle"
        android:layout_alignParentStart="true"
        android:layout_alignParentEnd="true"
        app:tl_indicator_color="@color/color_important"
        app:tl_indicator_corner_radius="5dp"
        app:tl_textBold="BOTH"
        app:tl_textSelectColor="@color/color_important"
        app:tl_textUnselectColor="@color/color_FFAEAFB3"
        app:tl_textsize="18sp"
        app:tl_underline_color="@color/color_FF3C3E4E"
        app:tl_underline_height="2dp"/>
    <com.mobile.brasiltv.view.NoScrollViewPager
        android:id="@+id/mMatchVp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/mMatchTab"
        android:layout_alignParentBottom="true"
        android:layout_alignParentStart="true"
        android:layout_alignParentEnd="true"/>
    <com.zhy.autolayout.AutoFrameLayout
        android:id="@+id/flSub"
        android:background="@mipmap/bg_subcribe_enter"
        android:layout_width="136px"
        android:layout_height="128px"
        android:layout_marginBottom="204px"
        android:layout_alignParentRight="true"
        android:layout_alignParentBottom="true">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/ivSub"
            android:layout_width="96px"
            android:layout_height="96px"
            android:src="@mipmap/icon_subscribe"/>
    </com.zhy.autolayout.AutoFrameLayout>
</com.zhy.autolayout.AutoRelativeLayout>
