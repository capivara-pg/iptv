<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/mLayoutEpisode"
    android:background="@drawable/shape_bg_pop_subtitle"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="16sp"
        android:textColor="@color/color_important_white"
        android:id="@+id/tvTitle"
        android:paddingTop="16dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginBottom="16dp"
        android:text="@string/play_selete_pisode"
        app:layout_constraintBottom_toTopOf="@+id/mBarrier"
        app:layout_constraintStart_toStartOf="parent"/>
    <ImageView
        android:id="@+id/mIvClose"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginRight="16dp"
        android:src="@drawable/icon_pop_subtitle_close"
        app:layout_constraintBottom_toBottomOf="@+id/tvTitle"
        app:layout_constraintEnd_toEndOf="parent"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/mBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="top"
        app:constraint_referenced_ids="mTabRv,mRvEpisode"/>
    <androidx.recyclerview.widget.RecyclerView
        android:orientation="horizontal"
        android:id="@+id/mTabRv"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="12dp"
        app:layout_constraintBottom_toTopOf="@+id/mRvEpisode"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/mRvEpisode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_max="508dp"
        app:layout_constraintHeight_min="110dp"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
