<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="6dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/conQuality"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="100dp"
        android:layout_height="40dp"
        android:maxWidth="100dp"
        android:maxHeight="40dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/mIvVip"
            android:visibility="gone"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@mipmap/icon_download_quality_vip"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/tvQuality"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="15sp"
            android:textColor="@color/color_ffffff"
            android:id="@+id/tvQuality"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <FrameLayout
            android:id="@+id/mFlTag"
            android:background="@drawable/icon_plan_premium"
            android:visibility="visible"
            android:layout_width="44dp"
            android:layout_height="16dp"
            android:layout_marginLeft="-6dp"
            android:layout_marginTop="-6dp"
            android:layout_marginRight="-6dp"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:textSize="8sp"
                android:textColor="@color/color_4d3b1f"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/mTvTag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
