<?xml version="1.0" encoding="utf-8"?>
<com.zhy.autolayout.AutoRelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/color_1f202a"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.mobile.brasiltv.view.TitleView
        android:id="@+id/titleView"
        android:layout_width="match_parent"
        android:layout_height="128px"
        app:titleViewTitle="@string/mine_redemption_center"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/white"
        android:id="@+id/tvUserId"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_below="@+id/titleView"
        android:layout_centerHorizontal="true"/>
    <EditText
        android:textSize="14sp"
        android:textColor="@color/color_ffffff"
        android:textColorHint="@color/color_999999"
        android:gravity="center"
        android:id="@+id/mEtExchangeCode"
        android:background="@drawable/bg_redemption_input"
        android:paddingLeft="24px"
        android:paddingRight="24px"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:layout_width="match_parent"
        android:layout_height="90px"
        android:layout_marginLeft="24px"
        android:layout_marginTop="31px"
        android:layout_marginRight="24px"
        android:hint="@string/redemption_please_exchange_code"
        android:singleLine="true"
        android:maxLength="19"
        android:layout_below="@+id/tvUserId"
        android:inputType="number"/>
    <ImageButton
        android:id="@+id/mIbClear"
        android:background="@color/transparent"
        android:visibility="gone"
        android:layout_width="36px"
        android:layout_height="36px"
        android:layout_marginTop="26px"
        android:layout_marginRight="20px"
        android:src="@drawable/icon_clear_input"
        android:scaleType="centerInside"
        android:layout_alignTop="@+id/mEtExchangeCode"
        android:layout_alignRight="@+id/mEtExchangeCode"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/color_99ffffff"
        android:id="@+id/mTvIntroduction1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="7dp"
        android:layout_marginRight="20dp"
        android:text="@string/after_purchasing_activation"
        android:layout_below="@+id/mEtExchangeCode"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/color_99ffffff"
        android:id="@+id/mTvIntroduction2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="7dp"
        android:layout_marginRight="20dp"
        android:text="@string/activation_code_only"
        android:layout_below="@+id/mTvIntroduction1"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/color_99ffffff"
        android:id="@+id/mTvIntroduction3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="7dp"
        android:layout_marginRight="20dp"
        android:text="@string/purchase_membership"
        android:layout_below="@+id/mTvIntroduction2"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/color_99ffffff"
        android:id="@+id/mTvIntroduction"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="7dp"
        android:layout_marginRight="20dp"
        android:text="@string/click_here_purchase"
        android:layout_below="@+id/mTvIntroduction3"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/color_99ffffff"
        android:autoLink="all"
        android:id="@+id/mTvWebString"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_below="@+id/mTvIntroduction"/>
    <com.mobile.brasiltv.view.CustomButton
        android:textSize="15sp"
        android:textColor="@color/color_ffffff"
        android:id="@+id/mKbConfirm"
        android:background="@drawable/bg_btn_redemption"
        android:layout_width="match_parent"
        android:layout_height="80px"
        android:layout_marginLeft="24px"
        android:layout_marginTop="20dp"
        android:layout_marginRight="24px"
        android:text="@string/confirm"
        android:layout_below="@+id/mTvWebString"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/color_f23232"
        android:gravity="center"
        android:id="@+id/mTvRedemptionHint"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="60px"
        android:layout_marginTop="56px"
        android:layout_marginRight="60px"
        android:layout_below="@+id/mKbConfirm"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/color_cccccc"
        android:gravity="center"
        android:id="@+id/tvWebsite"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="24px"
        android:layout_marginRight="24px"
        android:layout_marginBottom="100px"
        android:layout_alignParentBottom="true"/>
</com.zhy.autolayout.AutoRelativeLayout>
