<?xml version="1.0" encoding="utf-8"?>
<com.zhy.autolayout.AutoLinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:background="@color/color_191a23"
    android:visibility="visible"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/mImageNoRenewal"
        android:layout_width="348px"
        android:layout_height="268px"
        android:src="@drawable/ic_subscription_default"/>
    <TextView
        android:textSize="30px"
        android:textColor="@color/color_b3ffffff"
        android:gravity="center"
        android:id="@+id/mTvStatus"
        android:layout_width="644px"
        android:layout_height="wrap_content"
        android:layout_marginTop="12px"
        android:text="@string/no_auto_subscription"/>
    <TextView
        android:textSize="34px"
        android:textColor="@color/color_ffaa00"
        android:gravity="center"
        android:id="@+id/mTvViewAndSubscribe"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12px"
        android:text="@string/view_and_subscribe"/>
</com.zhy.autolayout.AutoLinearLayout>
