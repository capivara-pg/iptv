<?xml version="1.0" encoding="utf-8"?>
<com.mobile.brasiltv.view.AutoHideRelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mMatchControlPanelPortrait"
    android:background="@drawable/bg_play_fullscreen_shadow"
    android:visibility="visible"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.zhy.autolayout.AutoFrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/mIconBackPort"
            android:layout_width="80px"
            android:layout_height="96px"
            android:src="@drawable/ic_match_back"
            android:scaleType="center"/>
        <com.zhy.autolayout.AutoLinearLayout
            android:layout_gravity="top|right"
            android:orientation="horizontal"
            android:id="@+id/llMenu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/mDebugSwitch"
                android:visibility="gone"
                android:layout_width="48px"
                android:layout_height="48px"
                android:layout_marginTop="24px"
                android:layout_marginRight="48px"
                android:src="@mipmap/close"
                android:scaleType="fitCenter"/>
            <ImageView
                android:id="@+id/mImageFeedback"
                android:layout_width="48px"
                android:layout_height="48px"
                android:layout_marginTop="24px"
                android:layout_marginRight="48px"
                android:src="@drawable/ic_feedback"/>
            <ImageView
                android:id="@+id/mIvPortQuality"
                android:visibility="gone"
                android:layout_width="48px"
                android:layout_height="48px"
                android:layout_marginTop="24px"
                android:layout_marginRight="50px"
                android:src="@drawable/ic_quality_480p"/>
            <ImageView
                android:id="@+id/mIconCastPort"
                android:visibility="gone"
                android:layout_width="48px"
                android:layout_height="48px"
                android:layout_marginTop="24px"
                android:layout_marginRight="30px"
                android:src="@drawable/icon_cast"/>
        </com.zhy.autolayout.AutoLinearLayout>
        <ImageView
            android:layout_gravity="bottom"
            android:id="@+id/mIconSilence"
            android:padding="24px"
            android:layout_width="96px"
            android:layout_height="96px"
            android:src="@drawable/ic_live_volume_on"/>
        <ImageView
            android:layout_gravity="bottom|right"
            android:id="@+id/mIconFullscreen"
            android:padding="24px"
            android:layout_width="96px"
            android:layout_height="96px"
            android:src="@drawable/ic_live_fullscreen"/>
    </com.zhy.autolayout.AutoFrameLayout>
</com.mobile.brasiltv.view.AutoHideRelativeLayout>
