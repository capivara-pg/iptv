<?xml version="1.0" encoding="utf-8"?>
<com.zhy.autolayout.AutoLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:clickable="true"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.mobile.brasiltv.view.AutoCardView
        android:id="@+id/mLayoutStream"
        android:clickable="true"
        android:layout_width="379px"
        android:layout_height="214px"
        android:layout_marginLeft="12px"
        android:layout_marginRight="12px"
        app:cardCornerRadius="8px">
        <ImageView
            android:id="@+id/mImgPoster"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:foreground="?android:attr/selectableItemBackground"
            android:src="@drawable/bg_live_stream_item"
            android:scaleType="fitXY"/>
        <com.zhy.autolayout.AutoRelativeLayout
            android:layout_gravity="right"
            android:background="@drawable/shape_bg_identity"
            android:visibility="visible"
            android:layout_width="52px"
            android:layout_height="36px">
            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/mLottiePlaying"
                android:visibility="visible"
                android:layout_width="30px"
                android:layout_height="30px"
                android:layout_marginRight="10px"
                android:layout_centerInParent="true"
                app:lottie_autoPlay="true"
                app:lottie_loop="true"
                app:lottie_rawRes="@raw/live_channel_playing"/>
        </com.zhy.autolayout.AutoRelativeLayout>
    </com.mobile.brasiltv.view.AutoCardView>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/color_fffefe"
        android:id="@+id/mTvName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12px"
        android:layout_marginTop="20px"/>
</com.zhy.autolayout.AutoLinearLayout>
