<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mLayoutSetInfo"
    android:background="@color/color_80000000"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.zhy.autolayout.AutoFrameLayout
        android:id="@+id/mTitleLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="13dp"
        app:layout_constraintBottom_toTopOf="@+id/tvSeason">
        <TextView
            android:textSize="18sp"
            android:textColor="@color/color_important_white"
            android:id="@+id/mTvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="22dp"
            android:text="@string/play_selete_pisode"/>
        <ImageView
            android:layout_gravity="right"
            android:id="@+id/ivClose"
            android:padding="14px"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginRight="10px"
            android:src="@mipmap/close"/>
    </com.zhy.autolayout.AutoFrameLayout>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/color_e2e2e2"
        android:id="@+id/tvSeason"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="22dp"
        android:layout_marginBottom="12dp"
        android:text="Season"
        app:layout_constraintBottom_toTopOf="@+id/mBarrier"
        app:layout_constraintLeft_toLeftOf="parent"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/color_ffffff"
        android:id="@+id/tvEpisodes"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:text="Episodes"
        app:layout_constraintBottom_toBottomOf="@+id/tvSeason"
        app:layout_constraintLeft_toRightOf="@+id/tvSeason"
        app:layout_constraintTop_toTopOf="@+id/tvSeason"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/mBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="top"
        app:constraint_referenced_ids="mTabRv,recyclerSetInfo"/>
    <androidx.recyclerview.widget.RecyclerView
        android:orientation="horizontal"
        android:id="@+id/mTabRv"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="22dp"
        android:layout_marginRight="22dp"
        android:layout_marginBottom="12dp"
        app:layout_constraintBottom_toTopOf="@+id/recyclerSetInfo"/>
    <androidx.recyclerview.widget.RecyclerView
        android:scrollbarStyle="outsideOverlay"
        android:id="@+id/recyclerSetInfo"
        android:scrollbars="vertical"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginLeft="22dp"
        android:layout_marginRight="22dp"
        android:layout_marginBottom="20dp"
        android:fadeScrollbars="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHeight_max="217dp"
        app:layout_constraintHeight_min="110dp"/>
</androidx.constraintlayout.widget.ConstraintLayout>
