<?xml version="1.0" encoding="utf-8"?>
<com.zhy.autolayout.AutoLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.zhy.autolayout.AutoRelativeLayout
        android:id="@+id/mLayoutStream"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="36px"
            android:textStyle="bold"
            android:textColor="@color/ffffff"
            android:id="@+id/mTvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="23px"
            android:layout_marginTop="50px"
            android:layout_marginBottom="30px"/>
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/mLottiePlaying"
            android:layout_width="30px"
            android:layout_height="30px"
            android:layout_marginLeft="10px"
            android:layout_toRightOf="@+id/mTvTitle"
            android:layout_alignTop="@+id/mTvTitle"
            android:layout_alignBottom="@+id/mTvTitle"
            app:lottie_autoPlay="true"
            app:lottie_loop="true"
            app:lottie_rawRes="@raw/live_channel_playing"/>
        <TextView
            android:textSize="28px"
            android:textColor="@color/color_important"
            android:gravity="center"
            android:id="@+id/tvGo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="30px"
            android:text="@string/see_all"
            android:layout_alignTop="@+id/mTvTitle"
            android:layout_alignBottom="@+id/mTvTitle"
            android:layout_alignParentRight="true"/>
    </com.zhy.autolayout.AutoRelativeLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvStream"
        android:paddingLeft="10px"
        android:paddingRight="10px"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="3dp"
        android:layout_marginBottom="55px"/>
</com.zhy.autolayout.AutoLinearLayout>
