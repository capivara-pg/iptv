<?xml version="1.0" encoding="utf-8"?>
<com.zhy.autolayout.AutoLinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.zhy.autolayout.AutoLinearLayout
        android:orientation="vertical"
        android:background="@drawable/bg_standard_back"
        android:paddingBottom="48px"
        android:layout_width="622px"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/mTvTitle"
            android:paddingTop="64px"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <View
            android:background="@color/color_important"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="2px"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/color_8AFFFFFF"
            android:gravity="center"
            android:id="@+id/mTvMessage"
            android:layout_width="match_parent"
            android:layout_height="0px"
            android:layout_marginLeft="48px"
            android:layout_marginTop="16px"
            android:layout_marginRight="48px"
            android:layout_weight="1"/>
        <View
            android:background="@color/color_d5d5d5"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="1px"/>
        <com.zhy.autolayout.AutoLinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="15sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/mBtnRight"
                android:background="@drawable/bg_standard_submit"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="88px"
                android:layout_marginLeft="90px"
                android:layout_marginTop="48px"
                android:layout_marginRight="90px"/>
            <TextView
                android:textSize="15sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/mBtnLeft"
                android:background="@drawable/bg_standard_cannel"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="88px"
                android:layout_marginLeft="90px"
                android:layout_marginTop="32px"
                android:layout_marginRight="90px"/>
            <View
                android:id="@+id/mIvLine"
                android:background="@color/color_d5d5d5"
                android:visibility="gone"
                android:layout_width="1px"
                android:layout_height="match_parent"/>
        </com.zhy.autolayout.AutoLinearLayout>
    </com.zhy.autolayout.AutoLinearLayout>
</com.zhy.autolayout.AutoLinearLayout>
