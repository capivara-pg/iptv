<?xml version="1.0" encoding="utf-8"?>
<com.zhy.autolayout.AutoLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/color_1f202a"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.mobile.brasiltv.view.TitleBarView
        android:id="@+id/titleView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:titleBgColor="@color/color_191a23"
        app:titleCloseIcon="@drawable/icon_close_white"
        app:titleText="@string/be_bind_suc_title"
        app:titleTextColor="@color/color_ffffff"/>
    <ImageView
        android:layout_gravity="center_horizontal"
        android:layout_width="153px"
        android:layout_height="153px"
        android:layout_marginTop="233px"
        android:src="@drawable/ic_operate_suc"
        android:scaleType="fitXY"/>
    <TextView
        android:textSize="30px"
        android:textColor="@color/white"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/bindStatus"
        android:paddingLeft="20px"
        android:paddingRight="20px"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="98px"
        android:text="@string/phone_bind_success_notice1"/>
    <TextView
        android:textSize="30px"
        android:textColor="@color/white"
        android:layout_gravity="center_horizontal"
        android:id="@+id/noticeText"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="25px"
        android:text="@string/phone_bind_success_notice2"/>
</com.zhy.autolayout.AutoLinearLayout>
