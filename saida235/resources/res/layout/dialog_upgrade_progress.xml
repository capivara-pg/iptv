<?xml version="1.0" encoding="utf-8"?>
<com.zhy.autolayout.AutoLinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.zhy.autolayout.AutoLinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="230px">
        <TextView
            android:textSize="42px"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:id="@+id/mTvUpdating"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/force_upgrade_updating"/>
        <TextView
            android:textSize="26px"
            android:textColor="#ffaa00"
            android:id="@+id/mTvDontCloseApp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10px"
            android:text="@string/force_upgrade_dont_close_app"/>
        <TextView
            android:textSize="32px"
            android:textColor="#ff3333"
            android:id="@+id/mTvDownloadFail"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/force_upgrade_download_fail"/>
    </com.zhy.autolayout.AutoLinearLayout>
    <com.zhy.autolayout.AutoLinearLayout
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="360px">
        <TextView
            android:textSize="32px"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:id="@+id/mTvNewFunc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/new_function"/>
        <TextView
            android:textSize="28px"
            android:textColor="@android:color/white"
            android:id="@+id/mTvVersion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="17px"
            android:text="@string/normal_upgrade_version"/>
    </com.zhy.autolayout.AutoLinearLayout>
    <com.mobile.view.ScrollTextView
        android:textSize="28px"
        android:textColor="#c4c4c4"
        android:layout_width="1200px"
        android:layout_height="230px"
        android:layout_marginLeft="360px"
        android:layout_marginTop="40px"/>
    <com.zhy.autolayout.AutoLinearLayout
        android:orientation="horizontal"
        android:id="@+id/mAllDownloadLink"
        android:layout_width="wrap_content"
        android:layout_height="28px"
        android:layout_marginLeft="360px"
        android:layout_marginTop="50px"
        android:layout_marginBottom="40px">
        <com.mobile.view.UpgradeProgressView
            android:id="@+id/mUpvProgress"
            android:layout_width="1080px"
            android:layout_height="match_parent"/>
        <TextView
            android:textSize="24px"
            android:textColor="@android:color/white"
            android:layout_gravity="center_vertical"
            android:id="@+id/mTvNetSpeed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10px"/>
    </com.zhy.autolayout.AutoLinearLayout>
    <com.zhy.autolayout.AutoLinearLayout
        android:orientation="horizontal"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="360px"
        android:layout_marginRight="360px">
        <TextView
            android:textSize="28px"
            android:textColor="@android:color/white"
            android:id="@+id/mTvDownloadLinkDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/force_upgrade_download_link"/>
        <TextView
            android:textSize="28px"
            android:textColor="#3b9dff"
            android:id="@+id/mTvDownloadLink"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="http://www.uniquetv.live/download"/>
    </com.zhy.autolayout.AutoLinearLayout>
    <TextView
        android:textSize="28px"
        android:textColor="@android:color/white"
        android:id="@+id/mTvDownloadHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="360px"
        android:layout_marginRight="360px"
        android:text="@string/normal_upgrade_goto_app_store"/>
    <TextView
        android:textSize="28px"
        android:textColor="@android:color/white"
        android:id="@+id/mTvContract"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="360px"
        android:layout_marginRight="360px"
        android:text="@string/force_upgrade_contract_email"/>
    <com.zhy.autolayout.AutoFrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <Button
            android:textSize="32px"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/mBtnClose"
            android:visibility="gone"
            android:layout_width="480px"
            android:layout_height="80px"
            android:layout_marginTop="80px"
            android:text="@string/force_upgrade_close"/>
        <TextView
            android:textSize="26px"
            android:textColor="#c4c4c4"
            android:layout_gravity="bottom|center_horizontal"
            android:id="@+id/mTvCurrentVersion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="40px"
            android:text="@string/force_upgrade_current_version"/>
    </com.zhy.autolayout.AutoFrameLayout>
</com.zhy.autolayout.AutoLinearLayout>
