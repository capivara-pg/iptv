<?xml version="1.0" encoding="utf-8"?>
<com.zhy.autolayout.AutoFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.zhy.autolayout.AutoFrameLayout
        android:background="@drawable/bg_dialog_notify"
        android:layout_width="606px"
        android:layout_height="554px">
        <ImageView
            android:layout_gravity="right"
            android:id="@+id/mIvClose"
            android:layout_width="32px"
            android:layout_height="32px"
            android:layout_marginTop="24px"
            android:layout_marginRight="24px"
            android:src="@drawable/icon_dialog_close"/>
        <TextView
            android:textSize="32px"
            android:textColor="@color/color_ffffff"
            android:ellipsize="marquee"
            android:gravity="center"
            android:id="@+id/mTvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="64px"
            android:text="@string/data_play_notify"
            android:singleLine="true"
            android:marqueeRepeatLimit="marquee_forever"/>
        <TextView
            android:textSize="24px"
            android:textColor="@color/color_B3FFFEFE"
            android:gravity="center"
            android:id="@+id/mTvContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="40px"
            android:layout_marginTop="158px"
            android:layout_marginRight="40px"
            android:text="@string/data_play_tips"/>
        <TextView
            android:textSize="32px"
            android:textColor="@color/color_ffffff"
            android:ellipsize="marquee"
            android:gravity="center"
            android:layout_gravity="bottom|center_horizontal"
            android:id="@+id/mTvTop"
            android:background="@drawable/bg_filter_cond_enable"
            android:layout_width="520px"
            android:layout_height="80px"
            android:layout_marginBottom="140px"
            android:text="@string/data_play_to_setting"
            android:singleLine="true"
            android:marqueeRepeatLimit="marquee_forever"/>
        <TextView
            android:textSize="32px"
            android:textColor="@color/color_ffffff"
            android:ellipsize="marquee"
            android:gravity="center"
            android:layout_gravity="bottom|center_horizontal"
            android:id="@+id/mTvBottom"
            android:background="@drawable/bg_common_cancel"
            android:layout_width="520px"
            android:layout_height="80px"
            android:layout_marginBottom="44px"
            android:text="@string/data_play_continue_playing"
            android:singleLine="true"
            android:marqueeRepeatLimit="marquee_forever"/>
    </com.zhy.autolayout.AutoFrameLayout>
</com.zhy.autolayout.AutoFrameLayout>
