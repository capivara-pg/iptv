<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/mLayoutProgress"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <ProgressBar
            android:gravity="center"
            android:id="@+id/mProgressBar"
            android:focusable="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:max="100"
            android:progress="0"
            style="@android:style/Widget.ProgressBar.Horizontal"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/color_ffffff"
            android:id="@+id/mTvProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0%"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
    <LinearLayout
        android:gravity="center"
        android:id="@+id/mLayoutDownload"
        android:background="@drawable/shape_vod_movie_none_bg"
        android:layout_width="128dp"
        android:layout_height="40dp">
        <ImageView
            android:id="@+id/mIvFinish"
            android:visibility="gone"
            android:layout_width="20dp"
            android:layout_height="14dp"
            android:src="@drawable/icon_vod_movie_download_finish"
            android:layout_centerInParent="true"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/color_ffffff"
            android:id="@+id/mTvDownload"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/vod_movie_bt_download"/>
    </LinearLayout>
</merge>
