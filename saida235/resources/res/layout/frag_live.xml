<?xml version="1.0" encoding="utf-8"?>
<com.zhy.autolayout.AutoRelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/color_191a23"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.zhy.autolayout.AutoRelativeLayout
        android:gravity="center_vertical"
        android:id="@+id/mLayoutTitle"
        android:background="@color/color_191a23"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:gravity="center"
            android:id="@+id/mCinemaTitle"
            android:layout_width="100px"
            android:layout_height="88px"
            android:layout_marginLeft="30px"
            android:layout_marginTop="65px"
            android:src="@mipmap/icon_home_logo"/>
        <com.zhy.autolayout.AutoRelativeLayout
            android:id="@+id/mVodConSearch"
            android:background="@drawable/bg_home_search_c6d6ff"
            android:layout_width="match_parent"
            android:layout_height="72px"
            android:layout_marginLeft="24px"
            android:layout_marginTop="75px"
            android:layout_marginRight="30px"
            android:layout_toRightOf="@+id/mCinemaTitle">
            <ImageView
                android:id="@+id/mVodImageSearch"
                android:background="@drawable/icon_home_search"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16px"
                android:layout_centerVertical="true"/>
            <TextView
                android:textSize="15sp"
                android:textColor="@color/color_5EFFFFFF"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16px"
                android:text="@string/channel_searchs"
                android:layout_toRightOf="@+id/mVodImageSearch"
                android:layout_centerVertical="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toRightOf="@+id/mVodImageSearch"
                app:layout_constraintTop_toTopOf="parent"/>
        </com.zhy.autolayout.AutoRelativeLayout>
    </com.zhy.autolayout.AutoRelativeLayout>
    <com.mobile.brasiltv.view.RatioFrameLayout
        android:id="@+id/livePlayFrg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/mLayoutTitle"
        app:enable="true"
        app:ratio="1.78"/>
    <com.flyco.tablayout.SlidingTabLayout
        android:id="@+id/liveTabLayout"
        android:background="@color/color_191a23"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="100px"
        android:layout_below="@+id/livePlayFrg"
        android:elevation="9px"
        app:tl_divider_color="@color/color_cccccc"
        app:tl_divider_padding="34px"
        app:tl_divider_width="1px"
        app:tl_indicator_color="@color/transparent"
        app:tl_indicator_width="0px"
        app:tl_tab_space_equal="true"
        app:tl_textSelectColor="@color/color_important"
        app:tl_textUnselectColor="@color/color_999999"
        app:tl_textsize="16sp"/>
    <com.zhy.autolayout.AutoRelativeLayout
        android:id="@+id/mLayoutViewPager"
        android:background="@color/color_191a23"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/liveTabLayout">
        <androidx.viewpager.widget.ViewPager
            android:id="@+id/liveViewPager"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </com.zhy.autolayout.AutoRelativeLayout>
    <com.zhy.autolayout.AutoLinearLayout
        android:orientation="horizontal"
        android:id="@+id/mLayoutEPGTitle"
        android:background="@color/color_191a23"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="80px"
        android:layout_below="@+id/livePlayFrg">
        <ImageView
            android:layout_gravity="center_vertical"
            android:layout_width="16px"
            android:layout_height="30px"
            android:layout_marginLeft="28px"
            android:src="@drawable/icon_epg_arrow"
            android:scaleType="fitXY"/>
        <TextView
            android:textSize="30px"
            android:textColor="@color/ffffff"
            android:gravity="center_vertical"
            android:id="@+id/mTextEpgChannel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="19px"
            android:text="TNT HD"/>
    </com.zhy.autolayout.AutoLinearLayout>
    <com.zhy.autolayout.AutoRelativeLayout
        android:id="@+id/mLayoutEpgContent"
        android:background="@color/color_191a23"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/mLayoutEPGTitle">
        <com.zhy.autolayout.AutoFrameLayout
            android:id="@+id/mLayoutEPGFragment"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </com.zhy.autolayout.AutoRelativeLayout>
</com.zhy.autolayout.AutoRelativeLayout>
