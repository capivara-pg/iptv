<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.mobile.videodownloads.view.AutoCardView
        android:orientation="vertical"
        android:id="@+id/mLayout"
        android:layout_width="71dp"
        android:layout_height="99dp"
        android:layout_marginLeft="13dp"
        android:layout_marginTop="15dp"
        android:layout_marginBottom="32dp"
        app:cardCornerRadius="5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/posterImageView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/special_cloumn_img_placeholder"
            android:scaleType="centerCrop"/>
    </com.mobile.videodownloads.view.AutoCardView>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/color_ffffff"
        android:ellipsize="end"
        android:id="@+id/tvContentTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="22dp"
        android:maxLines="2"
        app:layout_constraintLeft_toRightOf="@+id/mLayout"
        app:layout_constraintRight_toLeftOf="@+id/imgStatus"
        app:layout_constraintTop_toTopOf="@+id/mLayout"/>
    <ImageView
        android:id="@+id/imgScore"
        android:background="@mipmap/icon_score_download"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="9dp"
        app:layout_constraintLeft_toRightOf="@+id/mLayout"
        app:layout_constraintTop_toBottomOf="@+id/tvContentTitle"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/color_ffaa00"
        android:id="@+id/tvScore"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="5dp"
        app:layout_constraintBottom_toBottomOf="@+id/imgScore"
        app:layout_constraintLeft_toRightOf="@+id/imgScore"
        app:layout_constraintTop_toTopOf="@+id/imgScore"/>
    <ImageView
        android:id="@+id/imgStatus"
        android:background="@mipmap/icon_status_download"
        android:layout_width="18dp"
        android:layout_height="17dp"
        android:layout_marginRight="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/mLayout"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/mLayout"/>
</androidx.constraintlayout.widget.ConstraintLayout>
