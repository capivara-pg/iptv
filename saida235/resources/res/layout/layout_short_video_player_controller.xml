<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/color_000000"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/mIvPoster"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/mIvPlay"
        android:visibility="gone"
        android:layout_width="108px"
        android:layout_height="108px"
        android:src="@drawable/icon_short_video_pause"
        android:scaleType="fitCenter"/>
    <TextView
        android:textSize="24px"
        android:textColor="@color/color_ffffff"
        android:gravity="center"
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/mTvFullScreen"
        android:background="@drawable/shape_bg_full_screen_button"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="200px"
        android:layout_height="56px"
        android:layout_marginBottom="392px"
        android:text="@string/full_screen"/>
    <com.zhy.autolayout.AutoRelativeLayout
        android:layout_gravity="bottom|right"
        android:id="@+id/mLlFunction"
        android:layout_width="96px"
        android:layout_height="600px"
        android:layout_marginRight="20px"
        android:layout_marginBottom="96px">
        <ImageView
            android:id="@+id/mIvThumbsUp"
            android:layout_width="96px"
            android:layout_height="96px"
            android:src="@drawable/icon_thumbs_up_normal"
            android:scaleType="fitCenter"
            android:layout_alignParentLeft="true"
            android:layout_alignParentTop="true"
            android:layout_alignParentRight="true"/>
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/mAvThumbsUp"
            android:visibility="gone"
            android:layout_width="96px"
            android:layout_height="96px"
            android:layout_alignLeft="@+id/mIvThumbsUp"
            android:layout_alignTop="@+id/mIvThumbsUp"
            android:layout_alignRight="@+id/mIvThumbsUp"
            android:layout_alignBottom="@+id/mIvThumbsUp"
            app:lottie_autoPlay="false"
            app:lottie_loop="false"
            app:lottie_rawRes="@raw/animation_like"/>
        <TextView
            android:textSize="20px"
            android:textColor="@color/color_FFFEFE"
            android:gravity="top|center_horizontal"
            android:id="@+id/mTvLikedNum"
            android:paddingTop="5px"
            android:layout_width="96px"
            android:layout_height="54px"
            android:layout_below="@+id/mIvThumbsUp"
            android:layout_alignParentLeft="true"
            android:layout_alignParentRight="true"/>
        <ImageView
            android:id="@+id/mIvFavorite"
            android:layout_width="96px"
            android:layout_height="96px"
            android:src="@drawable/icon_favorite_normal"
            android:scaleType="fitCenter"
            android:layout_below="@+id/mTvLikedNum"
            android:layout_alignParentLeft="true"
            android:layout_alignParentRight="true"/>
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/mAvFavorite"
            android:visibility="gone"
            android:layout_width="96px"
            android:layout_height="96px"
            android:layout_alignLeft="@+id/mIvFavorite"
            android:layout_alignTop="@+id/mIvFavorite"
            android:layout_alignRight="@+id/mIvFavorite"
            android:layout_alignBottom="@+id/mIvFavorite"
            app:lottie_autoPlay="false"
            app:lottie_loop="false"
            app:lottie_rawRes="@raw/animation_favorite"/>
        <TextView
            android:textSize="20px"
            android:textColor="@color/color_FFFEFE"
            android:gravity="top|center_horizontal"
            android:id="@+id/mTvFavorite"
            android:paddingTop="5px"
            android:layout_width="96px"
            android:layout_height="54px"
            android:text="@string/fun_favorite"
            android:layout_below="@+id/mIvFavorite"
            android:layout_alignParentLeft="true"
            android:layout_alignParentRight="true"/>
        <ImageView
            android:id="@+id/mIvShare"
            android:layout_width="96px"
            android:layout_height="96px"
            android:src="@drawable/icon_share"
            android:scaleType="fitCenter"
            android:layout_below="@+id/mTvFavorite"
            android:layout_alignParentLeft="true"
            android:layout_alignParentRight="true"/>
        <TextView
            android:textSize="20px"
            android:textColor="@color/color_FFFEFE"
            android:gravity="top|center_horizontal"
            android:id="@+id/mTvShare"
            android:paddingTop="5px"
            android:layout_width="96px"
            android:layout_height="54px"
            android:text="@string/fun_share"
            android:layout_below="@+id/mIvShare"
            android:layout_alignParentLeft="true"
            android:layout_alignParentRight="true"/>
        <ImageView
            android:id="@+id/mIvFeedback"
            android:layout_width="96px"
            android:layout_height="96px"
            android:src="@drawable/icon_feedback"
            android:scaleType="fitCenter"
            android:layout_below="@+id/mTvShare"
            android:layout_alignParentLeft="true"
            android:layout_alignParentRight="true"/>
        <TextView
            android:textSize="20px"
            android:textColor="@color/color_FFFEFE"
            android:gravity="top|center_horizontal"
            android:paddingTop="5px"
            android:layout_width="96px"
            android:layout_height="54px"
            android:text="@string/fun_feedback"
            android:layout_below="@+id/mIvFeedback"
            android:layout_alignParentLeft="true"
            android:layout_alignParentRight="true"/>
    </com.zhy.autolayout.AutoRelativeLayout>
    <com.zhy.autolayout.AutoFrameLayout
        android:layout_gravity="bottom"
        android:id="@+id/mFlPortraitSeekBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_gravity="bottom"
            android:id="@+id/mIvBuffer"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="20px"
            android:layout_marginLeft="8px"
            android:layout_marginRight="8px"
            android:src="@drawable/animation_buffer_loading"
            android:scaleType="fitXY"/>
        <com.shortvideo.view.ShortVideoSeekBar
            android:layout_gravity="bottom"
            android:id="@+id/mShortVideoSeekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </com.zhy.autolayout.AutoFrameLayout>
    <com.zhy.autolayout.AutoLinearLayout
        android:gravity="bottom"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:id="@+id/mLlPortrait"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="52px">
        <TextView
            android:textSize="24px"
            android:textColor="@color/color_FFFEFE"
            android:gravity="center_vertical"
            android:layout_gravity="bottom"
            android:id="@+id/mTvWatchContent"
            android:background="@drawable/shape_bg_watch_content"
            android:paddingLeft="16px"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="64px"
            android:layout_marginLeft="32px"
            android:layout_marginBottom="8px"
            android:minWidth="296px"
            android:text="@string/watch_content"
            android:drawableLeft="@drawable/icon_watch_content_play"
            android:drawablePadding="8px"/>
        <TextView
            android:textSize="32px"
            android:textColor="@color/color_FFFEFE"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/mTvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="32px"
            android:layout_marginBottom="8px"
            android:maxWidth="488px"
            android:text="The Fall Guy Highlights The Fall Guy Highlights Xxxxxx abcdefghijklmn opqrstuvwxyz"
            android:maxLines="2"/>
        <com.shortvideo.view.expandable.ExpandableTextView
            android:textSize="28px"
            android:textColor="@color/color_B3FFFEFE"
            android:layout_gravity="bottom"
            android:id="@+id/mTvDetail"
            android:layout_width="560px"
            android:layout_height="wrap_content"
            android:layout_marginLeft="32px"
            android:shadowColor="@color/color_33000000"
            android:shadowDy="2"
            android:shadowRadius="2"
            android:lineSpacingExtra="4dp"
            app:ep_contract_color="@color/color_ffffff"
            app:ep_expand_color="@color/color_ffffff"
            app:ep_max_line="2"
            app:ep_need_contract="true"
            app:ep_need_expand="true"
            app:ep_need_link="false"
            app:ep_need_mention="false"/>
    </com.zhy.autolayout.AutoLinearLayout>
    <com.shortvideo.view.AlphaFrameLayout
        android:id="@+id/mFlFullScreen"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/mIvFullBack"
            android:layout_width="56px"
            android:layout_height="56px"
            android:layout_marginLeft="76px"
            android:layout_marginTop="60px"
            android:src="@drawable/icon_back_arrow"
            android:scaleType="fitCenter"/>
        <TextView
            android:textSize="32px"
            android:textColor="@color/color_FFFEFE"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/mTvFullTitle"
            android:layout_width="wrap_content"
            android:layout_height="46px"
            android:layout_marginLeft="136px"
            android:layout_marginTop="64px"
            android:maxWidth="1200px"
            android:text="The Fall Guy Highlights The Fall Guy Highlights Xxxxxx abcdefghijklmn opqrstuvwxyz"
            android:singleLine="true"/>
        <SeekBar
            android:layout_gravity="bottom"
            android:id="@+id/mFullSeekBar"
            android:layout_width="1352px"
            android:layout_height="40px"
            android:layout_marginLeft="64px"
            android:layout_marginBottom="176px"
            android:maxHeight="8px"
            android:progress="0"
            android:progressDrawable="@drawable/seekbar_full"
            android:minHeight="8px"
            android:thumb="@drawable/shape_seek_bar_thumb_full"/>
        <ImageView
            android:layout_gravity="bottom|left"
            android:id="@+id/mIvFullPlay"
            android:layout_width="48px"
            android:layout_height="48px"
            android:layout_marginLeft="80px"
            android:layout_marginBottom="64px"
            android:src="@drawable/icon_full_pause"/>
        <TextView
            android:textSize="28px"
            android:textColor="@color/color_ffffff"
            android:gravity="center"
            android:layout_gravity="bottom|left"
            android:id="@+id/mTvCurTime"
            android:layout_width="152px"
            android:layout_height="40px"
            android:layout_marginLeft="128px"
            android:layout_marginBottom="68px"/>
        <TextView
            android:textSize="28px"
            android:textColor="@color/color_80FFFFFF"
            android:gravity="center_vertical"
            android:layout_gravity="bottom|left"
            android:id="@+id/mTvTotalTime"
            android:layout_width="wrap_content"
            android:layout_height="40px"
            android:layout_marginLeft="288px"
            android:layout_marginBottom="68px"/>
        <TextView
            android:textSize="24px"
            android:textColor="@color/color_FFFEFE"
            android:gravity="center_vertical"
            android:layout_gravity="bottom|right"
            android:id="@+id/mTvFullWatchContent"
            android:background="@drawable/shape_bg_watch_content"
            android:paddingLeft="16px"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="64px"
            android:layout_marginRight="224px"
            android:layout_marginBottom="56px"
            android:minWidth="296px"
            android:text="@string/watch_content"
            android:drawableLeft="@drawable/icon_watch_content_play"
            android:drawablePadding="8px"/>
    </com.shortvideo.view.AlphaFrameLayout>
</merge>
