<?xml version="1.0" encoding="utf-8"?>
<com.zhy.autolayout.AutoFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.zhy.autolayout.AutoRelativeLayout
        android:id="@+id/mLayoutSplash"
        android:background="@drawable/bg_splash"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/mIvlogo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/icon_splah_logo"
            android:scaleType="fitXY"
            android:layout_centerHorizontal="true"/>
        <com.zhy.autolayout.AutoLinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="250dp"
            android:layout_alignTop="@+id/mIvlogo"
            android:layout_centerHorizontal="true">
            <TextView
                android:textSize="18sp"
                android:textColor="@android:color/white"
                android:layout_gravity="center"
                android:id="@+id/tvAppName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:text="@string/app_name"/>
            <ImageView
                android:id="@+id/ivSlogan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="60px"/>
        </com.zhy.autolayout.AutoLinearLayout>
        <ImageView
            android:id="@+id/viewIcon"
            android:background="@mipmap/icon_splash_unitv"
            android:visibility="gone"
            android:layout_width="80dp"
            android:layout_height="21dp"
            android:scaleType="centerCrop"
            android:layout_above="@+id/mTextVersion"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@android:color/white"
            android:layout_gravity="center"
            android:id="@+id/mTextVersion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="17dp"
            android:layout_marginBottom="150px"
            android:text="V1.0.1"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"/>
    </com.zhy.autolayout.AutoRelativeLayout>
    <ImageView
        android:id="@+id/mImageAdvert"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"/>
    <Button
        android:textSize="24px"
        android:textColor="@color/color_ffffff"
        android:layout_gravity="right"
        android:id="@+id/skipBtn"
        android:background="@drawable/shape_skip_ad_btn_bg"
        android:visibility="gone"
        android:layout_width="140px"
        android:layout_height="60px"
        android:layout_marginTop="30px"
        android:layout_marginRight="30px"
        android:text="5s skip"
        android:textAllCaps="false"/>
    <Button
        android:textSize="24px"
        android:textColor="@color/color_e6e6e6"
        android:layout_gravity="bottom|right"
        android:id="@+id/btnVersion"
        android:background="@drawable/shape_splash_version_bg"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="32px"
        android:layout_marginRight="30px"
        android:layout_marginBottom="30px"
        android:text="v: 5.14.2"
        android:textAllCaps="false"/>
</com.zhy.autolayout.AutoFrameLayout>
