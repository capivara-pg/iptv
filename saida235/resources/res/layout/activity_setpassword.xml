<?xml version="1.0" encoding="utf-8"?>
<com.zhy.autolayout.AutoLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/color_1f202a"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.mobile.brasiltv.view.TitleView
        android:id="@+id/mTitleView"
        android:layout_width="match_parent"
        android:layout_height="128px"
        app:titleViewTitle="@string/set_pwd"/>
    <com.zhy.autolayout.AutoLinearLayout
        android:orientation="vertical"
        android:id="@+id/resetPwd"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <EditText
            android:textSize="30px"
            android:textColor="@color/white"
            android:textColorHint="@color/color_99999"
            android:layout_gravity="center_horizontal"
            android:id="@+id/pwdFirst"
            android:background="@drawable/bg_edit_radius_input"
            android:paddingLeft="20px"
            android:focusable="true"
            android:layout_width="702px"
            android:layout_height="90px"
            android:layout_marginTop="30px"
            android:hint="@string/pwd_hint"
            android:singleLine="true"
            android:maxLength="12"
            android:digits="@string/filter_vcode"/>
        <TextView
            android:textSize="24px"
            android:textColor="@color/color_f23232"
            android:layout_gravity="center_horizontal"
            android:id="@+id/pwdFirstError"
            android:visibility="gone"
            android:layout_width="702px"
            android:layout_height="wrap_content"
            android:layout_marginTop="30px"
            android:text="@string/pwd_error"/>
        <EditText
            android:textSize="30px"
            android:textColor="@color/white"
            android:textColorHint="@color/color_99999"
            android:layout_gravity="center_horizontal"
            android:id="@+id/pwdSecond"
            android:background="@drawable/bg_edit_radius_input"
            android:paddingLeft="20px"
            android:focusable="true"
            android:layout_width="702px"
            android:layout_height="90px"
            android:layout_marginTop="30px"
            android:hint="@string/pwd_again"
            android:singleLine="true"
            android:maxLength="12"
            android:digits="@string/filter_vcode"/>
        <TextView
            android:textSize="24px"
            android:textColor="@color/color_f23232"
            android:layout_gravity="center_horizontal"
            android:id="@+id/pwdSecondError"
            android:visibility="gone"
            android:layout_width="702px"
            android:layout_height="wrap_content"
            android:layout_marginTop="30px"
            android:text="@string/not_match_password"
            android:digits="@string/filter_vcode"/>
        <TextView
            android:enabled="false"
            android:textSize="30px"
            android:textStyle="bold"
            android:textColor="@color/ffffff"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/confirmBt"
            android:background="@drawable/icon_mine_button"
            android:layout_width="704px"
            android:layout_height="80px"
            android:layout_marginLeft="24px"
            android:layout_marginTop="136px"
            android:layout_marginRight="24px"
            android:layout_marginBottom="100px"
            android:text="@string/sure"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"/>
    </com.zhy.autolayout.AutoLinearLayout>
    <com.zhy.autolayout.AutoRelativeLayout
        android:id="@+id/resetPwdSuccess"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/img"
            android:layout_width="103px"
            android:layout_height="129px"
            android:layout_marginTop="144px"
            android:src="@mipmap/ic_phone_reset"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textSize="26px"
            android:textColor="@color/white"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="41px"
            android:layout_marginTop="65px"
            android:layout_marginRight="41px"
            android:text="@string/pwd_reset_ok"
            android:layout_below="@+id/img"
            android:layout_centerHorizontal="true"/>
    </com.zhy.autolayout.AutoRelativeLayout>
</com.zhy.autolayout.AutoLinearLayout>
