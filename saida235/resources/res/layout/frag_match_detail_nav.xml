<?xml version="1.0" encoding="utf-8"?>
<com.zhy.autolayout.AutoFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingLeft="32px"
    android:paddingRight="32px"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.zhy.autolayout.AutoFrameLayout
        android:id="@+id/flIconTips"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="48px">
        <com.zhy.autolayout.AutoLinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_width="40px"
                android:layout_height="40px"
                android:src="@drawable/icon_match_event_goal"/>
            <TextView
                android:textSize="16px"
                android:textColor="@color/color_AEAFB3"
                android:gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8px"
                android:text="@string/match_event_goal"/>
            <ImageView
                android:layout_width="40px"
                android:layout_height="40px"
                android:layout_marginLeft="16px"
                android:src="@drawable/icon_match_red_card"/>
            <TextView
                android:textSize="16px"
                android:textColor="@color/color_AEAFB3"
                android:gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8px"
                android:text="@string/match_event_red_card"/>
            <ImageView
                android:layout_width="40px"
                android:layout_height="40px"
                android:layout_marginLeft="16px"
                android:src="@drawable/icon_match_yellow_card"/>
            <TextView
                android:textSize="16px"
                android:textColor="@color/color_AEAFB3"
                android:gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8px"
                android:text="@string/match_event_yellow_card"/>
            <ImageView
                android:layout_width="40px"
                android:layout_height="40px"
                android:layout_marginLeft="16px"
                android:src="@drawable/icon_match_event_change"/>
            <TextView
                android:textSize="16px"
                android:textColor="@color/color_AEAFB3"
                android:gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8px"
                android:text="@string/match_event_in_out"/>
        </com.zhy.autolayout.AutoLinearLayout>
        <View
            android:layout_gravity="bottom"
            android:background="@color/color_3d3d46"
            android:layout_width="match_parent"
            android:layout_height="2px"/>
    </com.zhy.autolayout.AutoFrameLayout>
    <com.zhy.autolayout.AutoRelativeLayout
        android:id="@+id/mTeamLayout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="92px"
        android:layout_marginTop="48px">
        <com.zhy.autolayout.AutoFrameLayout
            android:id="@+id/mVsOrSource"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true">
            <ImageView
                android:id="@+id/mImgVs"
                android:visibility="gone"
                android:layout_width="36px"
                android:layout_height="36px"
                android:src="@drawable/ic_match_vs"/>
            <TextView
                android:textSize="32px"
                android:textColor="@color/color_ffffff"
                android:id="@+id/mTvSource"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </com.zhy.autolayout.AutoFrameLayout>
        <ImageView
            android:id="@+id/mIvVisitTeam"
            android:layout_width="48px"
            android:layout_height="48px"
            android:layout_marginRight="40px"
            android:scaleType="fitCenter"
            android:layout_toLeftOf="@+id/mVsOrSource"
            android:layout_centerVertical="true"/>
        <TextView
            android:textSize="24px"
            android:textColor="@color/color_ffffff"
            android:ellipsize="end"
            android:gravity="right"
            android:id="@+id/mTvVisitTeam"
            android:paddingRight="16px"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="212px"
            android:maxLines="2"
            android:layout_toLeftOf="@+id/mIvVisitTeam"
            android:layout_centerVertical="true"/>
        <ImageView
            android:id="@+id/mIvHomeTeam"
            android:layout_width="48px"
            android:layout_height="48px"
            android:layout_marginLeft="40px"
            android:scaleType="fitCenter"
            android:layout_toRightOf="@+id/mVsOrSource"
            android:layout_centerVertical="true"/>
        <TextView
            android:textSize="24px"
            android:textColor="@color/color_ffffff"
            android:ellipsize="end"
            android:gravity="left"
            android:id="@+id/mTvHomeTeam"
            android:paddingLeft="16px"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="212px"
            android:maxLines="2"
            android:layout_toRightOf="@+id/mIvHomeTeam"
            android:layout_centerVertical="true"/>
    </com.zhy.autolayout.AutoRelativeLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/mRvMatchEvent"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="140px"/>
    <com.zhy.autolayout.AutoLinearLayout
        android:gravity="center_horizontal"
        android:layout_gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/mLayoutHint"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="208px">
        <ImageView
            android:layout_width="320px"
            android:layout_height="320px"
            android:src="@drawable/icon_no_completion_event"/>
        <TextView
            android:textSize="24px"
            android:textColor="@color/color_FF79797F"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20px"
            android:text="@string/match_no_event_tips"/>
    </com.zhy.autolayout.AutoLinearLayout>
    <com.mobile.brasiltv.view.SubLoadingView
        android:layout_gravity="center_horizontal"
        android:id="@+id/mLoading"
        android:visibility="gone"
        android:layout_width="100px"
        android:layout_height="100px"
        android:layout_marginTop="352px"/>
</com.zhy.autolayout.AutoFrameLayout>
