<?xml version="1.0" encoding="utf-8"?>
<com.zhy.autolayout.AutoFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.zhy.autolayout.AutoLinearLayout
        android:orientation="vertical"
        android:background="@drawable/bg_common_alert"
        android:paddingBottom="40px"
        android:layout_width="600px"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_gravity="right"
            android:id="@+id/ivClose"
            android:padding="30px"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@mipmap/close_big"/>
        <TextView
            android:textSize="36px"
            android:textStyle="bold"
            android:textColor="@color/color_1a1a1a"
            android:ellipsize="marquee"
            android:layout_gravity="center_horizontal"
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="30px"
            android:layout_marginRight="30px"
            android:singleLine="true"
            android:marqueeRepeatLimit="marquee_forever"/>
        <TextView
            android:textSize="24px"
            android:textColor="@color/color_333333"
            android:gravity="center"
            android:id="@+id/ivContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="50px"
            android:layout_marginTop="50px"
            android:layout_marginRight="50px"/>
        <TextView
            android:textSize="24px"
            android:textColor="@color/color_ffffff"
            android:ellipsize="marquee"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/tvTop"
            android:background="@drawable/shape_green_radius_solid"
            android:layout_width="480px"
            android:layout_height="90px"
            android:layout_marginTop="53px"
            android:singleLine="true"
            android:marqueeRepeatLimit="marquee_forever"/>
        <TextView
            android:textSize="24px"
            android:textColor="@color/color_important"
            android:ellipsize="marquee"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/tvBottom"
            android:background="@drawable/shape_green_stroke"
            android:layout_width="480px"
            android:layout_height="90px"
            android:layout_marginTop="20px"
            android:layout_marginBottom="22px"
            android:singleLine="true"
            android:marqueeRepeatLimit="marquee_forever"/>
        <TextView
            android:textSize="24px"
            android:textColor="@color/color_ff9500"
            android:layout_gravity="center_horizontal"
            android:id="@+id/mtvTips"
            android:visibility="gone"
            android:layout_width="540px"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10px"/>
    </com.zhy.autolayout.AutoLinearLayout>
</com.zhy.autolayout.AutoFrameLayout>
