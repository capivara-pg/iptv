<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">
    <com.adimage.view.TraceAdImageView
        android:id="@+id/mIvAd"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"/>
    <com.zhy.autolayout.AutoLinearLayout
        android:gravity="center"
        android:layout_gravity="top|right"
        android:orientation="horizontal"
        android:background="@color/color_cc000000"
        android:paddingLeft="20px"
        android:paddingRight="15px"
        android:layout_width="wrap_content"
        android:layout_height="48px">
        <com.adimage.view.TraceAdImageView
            android:layout_width="42px"
            android:layout_height="28px"
            android:src="@drawable/ic_ad_key_down"
            android:scaleType="fitXY"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/color_ffffff"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="9px"
            android:text="@string/ad_key_down_to_close"/>
        <com.adimage.view.TraceAdImageView
            android:id="@+id/mIvKey0"
            android:visibility="gone"
            android:layout_width="42px"
            android:layout_height="28px"
            android:layout_marginLeft="20px"
            android:src="@drawable/ic_ad_key_0"
            android:scaleType="fitXY"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/color_ffffff"
            android:id="@+id/mTvKeyDesc"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10px"
            android:text="@string/ad_key_0_for_more"/>
    </com.zhy.autolayout.AutoLinearLayout>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/color_ffffff"
        android:gravity="center"
        android:layout_gravity="bottom|left"
        android:id="@+id/mTvFlag"
        android:background="@drawable/bg_pause_ad_flag"
        android:paddingLeft="32px"
        android:paddingRight="32px"
        android:layout_width="wrap_content"
        android:layout_height="58px"
        android:layout_marginLeft="10px"
        android:layout_marginBottom="10px"
        android:text="@string/ad_ad_flag"/>
</merge>
