<?xml version="1.0" encoding="utf-8"?>
<com.zhy.autolayout.AutoFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:padding="12px"
    android:layout_width="match_parent"
    android:layout_height="344px">
    <com.zhy.autolayout.AutoLinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/llContainer"
        android:background="@drawable/bg_limit_device"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/mIvDeviceType"
            android:layout_width="74px"
            android:layout_height="74px"
            android:layout_marginTop="60px"
            android:src="@drawable/ic_device_mob"/>
        <TextView
            android:textSize="28px"
            android:textColor="@color/white"
            android:ellipsize="end"
            android:id="@+id/mTvDeviceName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18px"
            android:singleLine="true"
            android:includeFontPadding="false"/>
        <TextView
            android:textSize="24px"
            android:textColor="@color/color_8D8E91"
            android:ellipsize="end"
            android:id="@+id/mTvLoginArea"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="36px"
            android:singleLine="true"
            android:includeFontPadding="false"/>
        <TextView
            android:textSize="24px"
            android:textColor="@color/color_8D8E91"
            android:ellipsize="end"
            android:id="@+id/mTvLoginTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16px"
            android:singleLine="true"
            android:includeFontPadding="false"/>
    </com.zhy.autolayout.AutoLinearLayout>
    <ImageView
        android:id="@+id/mIvSelect"
        android:layout_width="32px"
        android:layout_height="32px"
        android:layout_marginLeft="24px"
        android:layout_marginTop="24px"
        android:src="@drawable/bg_single_select"/>
    <TextView
        android:textSize="18px"
        android:textColor="@color/color_ffffff"
        android:gravity="center"
        android:id="@+id/tvMasterLabel"
        android:background="@drawable/bg_master_device_label"
        android:visibility="gone"
        android:layout_width="212px"
        android:layout_height="38px"
        android:text="@string/device_master_tips"
        android:textAllCaps="true"/>
</com.zhy.autolayout.AutoFrameLayout>
