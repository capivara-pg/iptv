<?xml version="1.0" encoding="utf-8"?>
<com.zhy.autolayout.AutoFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.zhy.autolayout.AutoRelativeLayout
        android:layout_width="980px"
        android:layout_height="660px">
        <TextView
            android:textSize="40px"
            android:gravity="center"
            android:id="@+id/mTvTitle"
            android:layout_width="match_parent"
            android:layout_height="100px"/>
        <TextView
            android:textSize="36px"
            android:id="@+id/mTvFunc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="52px"
            android:layout_marginTop="5px"
            android:layout_below="@+id/mTvTitle"/>
        <TextView
            android:textSize="24px"
            android:id="@+id/mTvVersionName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="52px"
            android:layout_alignBottom="@+id/mTvFunc"
            android:layout_alignParentRight="true"/>
        <TextView
            android:textSize="20px"
            android:textColor="@color/color_ababab"
            android:gravity="center"
            android:id="@+id/mTvServiceEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="17px"
            android:layout_marginBottom="20px"
            android:text="If you have any questions, please contact：Unitv4K@gmail.com"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"/>
        <com.zhy.autolayout.AutoLinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/mTvUserMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_above="@+id/mTvServiceEmail"
            android:layout_centerHorizontal="true">
            <TextView
                android:textSize="20px"
                android:textColor="@color/color_ababab"
                android:gravity="center"
                android:id="@+id/mTvCurrentVersion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Current Version：V1.8.0"/>
            <TextView
                android:textSize="20px"
                android:textColor="@color/color_ababab"
                android:gravity="center"
                android:id="@+id/mTvUserId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="62px"
                android:text="ID:8000630"/>
        </com.zhy.autolayout.AutoLinearLayout>
        <com.zhy.autolayout.AutoLinearLayout
            android:id="@+id/mAllBtnContainer"
            android:layout_width="wrap_content"
            android:layout_height="68px"
            android:layout_marginTop="53px"
            android:layout_marginBottom="35px"
            android:layout_above="@+id/mTvUserMessage"
            android:layout_centerHorizontal="true">
            <Button
                android:textSize="32px"
                android:gravity="center"
                android:id="@+id/mBtnCancel"
                android:layout_width="320px"
                android:layout_height="68px"
                android:layout_alignParentBottom="true"/>
            <Button
                android:textSize="32px"
                android:gravity="center"
                android:id="@+id/mBtnUpgrade"
                android:visibility="visible"
                android:layout_width="320px"
                android:layout_height="68px"
                android:layout_marginLeft="60px"
                android:layout_alignParentBottom="true"/>
        </com.zhy.autolayout.AutoLinearLayout>
        <TextView
            android:textSize="24px"
            android:id="@+id/mTvDownloadHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="52px"
            android:layout_marginRight="52px"
            android:layout_above="@+id/mAllBtnContainer"/>
        <TextView
            android:textSize="24px"
            android:id="@+id/mTvOfficialDownloadUrl"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="52px"
            android:layout_marginRight="52px"
            android:text="http://dwonload.youcine.net/dw"
            android:layout_above="@+id/mTvDownloadHint"/>
        <com.mobile.view.ScrollTextView
            android:textSize="28px"
            android:id="@+id/mStvReleaseNote"
            android:layout_width="match_parent"
            android:layout_height="130px"
            android:layout_marginLeft="52px"
            android:layout_marginTop="10px"
            android:layout_marginRight="52px"
            android:layout_marginBottom="10px"
            android:singleLine="false"
            android:layout_above="@+id/mTvOfficialDownloadUrl"
            android:layout_below="@+id/mTvFunc"
            android:lineSpacingExtra="10px"/>
    </com.zhy.autolayout.AutoRelativeLayout>
</com.zhy.autolayout.AutoFrameLayout>
