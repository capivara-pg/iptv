<?xml version="1.0" encoding="utf-8"?>
<com.zhy.autolayout.AutoLinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:id="@+id/mLayoutMobileNotify"
    android:background="@drawable/bg_play_control_centre"
    android:paddingLeft="30px"
    android:paddingRight="30px"
    android:visibility="gone"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_centerInParent="true">
    <TextView
        android:textSize="30px"
        android:textColor="@color/color_ffffff"
        android:gravity="center"
        android:id="@+id/mTextPlayNotify"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="21px"
        android:text="@string/mobile_net_play"/>
    <com.zhy.autolayout.AutoRelativeLayout
        android:layout_gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="49px"
        android:layout_marginBottom="13px">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/mTextToDo2"
            android:background="@drawable/bg_4c4c4c_4_radius"
            android:paddingTop="9px"
            android:paddingBottom="12px"
            android:visibility="gone"
            android:layout_width="240px"
            android:layout_height="wrap_content"
            android:text="@string/data_play_to_setting"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/mTextToDo"
            android:background="@drawable/shape_btn_update"
            android:paddingTop="9px"
            android:paddingBottom="12px"
            android:visibility="visible"
            android:layout_width="240px"
            android:layout_height="wrap_content"
            android:layout_marginLeft="30px"
            android:text="@string/click_continue"
            android:layout_toRightOf="@+id/mTextToDo2"/>
    </com.zhy.autolayout.AutoRelativeLayout>
</com.zhy.autolayout.AutoLinearLayout>
