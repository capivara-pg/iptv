<?xml version="1.0" encoding="utf-8"?>
<com.zhy.autolayout.AutoLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/color_bg"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.zhy.autolayout.AutoLinearLayout
        android:layout_width="match_parent"
        android:layout_height="88px">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/mIvBack"
            android:layout_width="48px"
            android:layout_height="48px"
            android:layout_marginLeft="16px"
            android:layout_marginRight="16px"
            android:src="@drawable/ic_title_back"
            android:scaleType="center"/>
        <com.zhy.autolayout.AutoRelativeLayout
            android:layout_gravity="center"
            android:background="@drawable/bg_border_search"
            android:layout_width="match_parent"
            android:layout_height="72px"
            android:layout_weight="1">
            <EditText
                android:textSize="28px"
                android:textColor="@color/white"
                android:textColorHint="@color/color_8D8E91"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/searchEt"
                android:background="@null"
                android:paddingLeft="16px"
                android:layout_width="match_parent"
                android:layout_height="60px"
                android:hint="@string/search_for_content_title"
                android:singleLine="true"
                android:layout_toLeftOf="@+id/searchClear"
                android:layout_centerVertical="true"
                android:imeOptions="actionSearch"
                android:textCursorDrawable="@drawable/icon_search_cursor"/>
            <ImageView
                android:id="@+id/searchClear"
                android:padding="20px"
                android:visibility="gone"
                android:layout_width="72px"
                android:layout_height="72px"
                android:src="@drawable/icon_search_clear"
                android:layout_alignParentRight="true"/>
        </com.zhy.autolayout.AutoRelativeLayout>
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/mIvSearch"
            android:background="@drawable/bg_btn_search"
            android:paddingLeft="23px"
            android:paddingTop="12px"
            android:paddingRight="23px"
            android:paddingBottom="12px"
            android:layout_width="94px"
            android:layout_height="72px"
            android:layout_marginRight="30px"
            android:src="@drawable/ic_title_search"/>
    </com.zhy.autolayout.AutoLinearLayout>
    <com.zhy.autolayout.AutoLinearLayout
        android:orientation="vertical"
        android:id="@+id/mLlSearchResult"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/mTabLayout"
            android:layout_width="match_parent"
            android:layout_height="84px"
            android:layout_marginLeft="32px"
            app:tabIndicatorHeight="0px"
            app:tabMinWidth="0dp"
            app:tabMode="scrollable"
            app:tabPaddingEnd="0dp"
            app:tabPaddingStart="0dp"/>
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/mViewPager2"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="40px"/>
    </com.zhy.autolayout.AutoLinearLayout>
    <com.zhy.autolayout.AutoRelativeLayout
        android:orientation="vertical"
        android:paddingTop="16px"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.zhy.autolayout.AutoLinearLayout
            android:orientation="vertical"
            android:id="@+id/searchHistoryLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.zhy.autolayout.AutoRelativeLayout
                android:layout_width="match_parent"
                android:layout_height="88px"
                android:layout_marginLeft="30px"
                android:layout_marginRight="30px">
                <TextView
                    android:textSize="36px"
                    android:textStyle="bold"
                    android:textColor="@color/color_ffffff"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/historical_search"
                    android:layout_centerVertical="true"/>
                <ImageView
                    android:id="@+id/historyDelete"
                    android:layout_width="34px"
                    android:layout_height="36px"
                    android:src="@drawable/ic_search_delete_history"
                    android:scaleType="fitXY"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"/>
            </com.zhy.autolayout.AutoRelativeLayout>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/searchHistoryList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="30px"
                android:layout_marginRight="30px"
                android:layout_marginBottom="20px"
                android:overScrollMode="never"/>
        </com.zhy.autolayout.AutoLinearLayout>
        <com.zhy.autolayout.AutoLinearLayout
            android:orientation="vertical"
            android:id="@+id/hotSearch"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/searchHistoryLayout">
            <TextView
                android:textSize="36px"
                android:textStyle="bold"
                android:textColor="@color/color_ffffff"
                android:gravity="center"
                android:paddingLeft="30px"
                android:layout_width="match_parent"
                android:layout_height="88px"
                android:layout_marginBottom="8px"
                android:text="@string/popular_search"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/hotSearchList"
                android:paddingLeft="30px"
                android:paddingRight="30px"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:overScrollMode="never"/>
        </com.zhy.autolayout.AutoLinearLayout>
        <com.zhy.autolayout.AutoLinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/mLlSearchEmpty"
            android:background="@color/color_1f202a"
            android:paddingBottom="160px"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_vod_search_no_data"/>
            <TextView
                android:textSize="24px"
                android:textColor="@color/color_999999"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32px"
                android:text="@string/search_no_result_remind"/>
        </com.zhy.autolayout.AutoLinearLayout>
    </com.zhy.autolayout.AutoRelativeLayout>
</com.zhy.autolayout.AutoLinearLayout>
