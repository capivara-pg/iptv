<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <com.zhy.autolayout.AutoLinearLayout
        android:orientation="vertical"
        android:id="@+id/mAllLineUpContainer"
        android:paddingLeft="30px"
        android:paddingRight="30px"
        android:paddingBottom="30px"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.zhy.autolayout.AutoLinearLayout
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="102px">
            <com.zhy.autolayout.AutoLinearLayout
                android:orientation="horizontal"
                android:id="@+id/mAllVisitTeam"
                android:background="@drawable/bg_nav_match_team"
                android:layout_width="wrap_content"
                android:layout_height="match_parent">
                <com.zhy.autolayout.AutoLinearLayout
                    android:layout_gravity="center_vertical"
                    android:orientation="vertical"
                    android:layout_width="192px"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="24px"
                    android:layout_marginRight="16px">
                    <TextView
                        android:textSize="24px"
                        android:textColor="@color/white"
                        android:ellipsize="end"
                        android:gravity="right"
                        android:id="@+id/mTvVisitTeam"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:includeFontPadding="false"/>
                    <TextView
                        android:textSize="24px"
                        android:textColor="@color/white"
                        android:ellipsize="end"
                        android:gravity="right"
                        android:id="@+id/mTvVisitLineUp"
                        android:paddingTop="8px"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:includeFontPadding="false"/>
                </com.zhy.autolayout.AutoLinearLayout>
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/mIvVisitTeam"
                    android:layout_width="48px"
                    android:layout_height="48px"
                    android:layout_marginRight="70px"
                    android:scaleType="fitCenter"/>
            </com.zhy.autolayout.AutoLinearLayout>
            <com.zhy.autolayout.AutoLinearLayout
                android:orientation="horizontal"
                android:id="@+id/mAllHomeTeam"
                android:background="@drawable/bg_nav_match_team"
                android:layout_width="wrap_content"
                android:layout_height="match_parent">
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/mIvHomeTeam"
                    android:layout_width="48px"
                    android:layout_height="48px"
                    android:layout_marginLeft="70px"
                    android:scaleType="fitCenter"/>
                <com.zhy.autolayout.AutoLinearLayout
                    android:layout_gravity="center_vertical"
                    android:orientation="vertical"
                    android:layout_width="192px"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16px"
                    android:layout_marginRight="24px">
                    <TextView
                        android:textSize="24px"
                        android:textColor="@color/white"
                        android:ellipsize="end"
                        android:id="@+id/mTvHomeTeam"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:includeFontPadding="false"/>
                    <TextView
                        android:textSize="24px"
                        android:textColor="@color/white"
                        android:ellipsize="end"
                        android:id="@+id/mTvHomeLineUp"
                        android:paddingTop="8px"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:includeFontPadding="false"/>
                </com.zhy.autolayout.AutoLinearLayout>
            </com.zhy.autolayout.AutoLinearLayout>
        </com.zhy.autolayout.AutoLinearLayout>
        <com.zhy.autolayout.AutoFrameLayout
            android:layout_width="match_parent"
            android:layout_height="1106px">
            <com.mobile.brasiltv.view.match.LineUpView
                android:id="@+id/mLineUp"
                android:background="@drawable/bg_lineup"
                android:layout_width="match_parent"
                android:layout_height="1082px"
                android:layout_marginTop="16px"
                android:layout_marginBottom="8px"/>
            <com.mobile.brasiltv.view.SubLoadingView
                android:layout_gravity="center"
                android:id="@+id/mLoading"
                android:visibility="gone"
                android:layout_width="100px"
                android:layout_height="100px"/>
        </com.zhy.autolayout.AutoFrameLayout>
    </com.zhy.autolayout.AutoLinearLayout>
</ScrollView>
