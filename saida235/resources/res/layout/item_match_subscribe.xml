<?xml version="1.0" encoding="utf-8"?>
<com.zhy.autolayout.AutoFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.zhy.autolayout.AutoLinearLayout
        android:orientation="vertical"
        android:id="@+id/mMatchLayout"
        android:background="@mipmap/bg_match_item"
        android:layout_width="match_parent"
        android:layout_height="280px"
        android:layout_marginLeft="20px"
        android:layout_marginTop="20px"
        android:layout_marginRight="20px">
        <com.zhy.autolayout.AutoLinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24px">
            <com.zhy.autolayout.AutoFrameLayout
                android:background="@drawable/bg_match_icon"
                android:layout_width="36px"
                android:layout_height="36px"
                android:layout_marginLeft="28px">
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/ivMatchIcon"
                    android:layout_width="20px"
                    android:layout_height="20px"/>
            </com.zhy.autolayout.AutoFrameLayout>
            <TextView
                android:textSize="24px"
                android:textColor="@color/color_ffffff"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:layout_gravity="center_vertical"
                android:id="@+id/tvMatchName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10px"
                android:singleLine="true"/>
        </com.zhy.autolayout.AutoLinearLayout>
        <com.zhy.autolayout.AutoLinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6px">
            <com.zhy.autolayout.AutoLinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="54px"
                android:layout_marginTop="12px"
                android:layout_weight="1">
                <ImageView
                    android:id="@+id/ivTeamAIcon"
                    android:background="@drawable/bg_match_team_icon"
                    android:padding="20px"
                    android:layout_width="124px"
                    android:layout_height="124px"/>
                <TextView
                    android:textSize="24px"
                    android:textColor="@color/color_ffffff"
                    android:ellipsize="marquee"
                    android:id="@+id/tvTeamAName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12px"
                    android:singleLine="true"/>
            </com.zhy.autolayout.AutoLinearLayout>
            <com.zhy.autolayout.AutoLinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:layout_width="304px"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="48px"
                    android:textStyle="bold"
                    android:textColor="@color/color_ffffff"
                    android:id="@+id/tvTimeOrScore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:textSize="24px"
                    android:textColor="@color/color_CCFFFFFF"
                    android:id="@+id/tvDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2px"/>
                <TextView
                    android:textSize="24px"
                    android:textColor="@color/color_ffffff"
                    android:gravity="center"
                    android:id="@+id/tvMatchState"
                    android:layout_width="256px"
                    android:layout_height="68px"
                    android:layout_marginTop="10px"
                    android:drawablePadding="-30dp"/>
            </com.zhy.autolayout.AutoLinearLayout>
            <com.zhy.autolayout.AutoLinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12px"
                android:layout_marginRight="54px"
                android:layout_weight="1">
                <ImageView
                    android:id="@+id/ivTeamBIcon"
                    android:background="@drawable/bg_match_team_icon"
                    android:padding="20px"
                    android:layout_width="124px"
                    android:layout_height="124px"/>
                <TextView
                    android:textSize="24px"
                    android:textColor="@color/color_ffffff"
                    android:ellipsize="marquee"
                    android:id="@+id/tvTeamBName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12px"
                    android:singleLine="true"/>
            </com.zhy.autolayout.AutoLinearLayout>
        </com.zhy.autolayout.AutoLinearLayout>
    </com.zhy.autolayout.AutoLinearLayout>
</com.zhy.autolayout.AutoFrameLayout>
