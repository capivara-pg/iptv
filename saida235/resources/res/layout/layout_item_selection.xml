<?xml version="1.0" encoding="utf-8"?>
<com.zhy.autolayout.AutoFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/bg_2c2c2c_4_radius"
    android:focusable="true"
    android:layout_width="50dp"
    android:layout_height="50dp">
    <TextView
        android:textSize="18sp"
        android:textColor="#ffff"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/mTextTitle"
        android:duplicateParentState="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <ImageView
        android:id="@+id/mIvSelect"
        android:visibility="gone"
        android:duplicateParentState="true"
        android:layout_width="24px"
        android:layout_height="24px"
        android:layout_marginLeft="4px"
        android:layout_marginTop="4px"/>
    <ImageView
        android:layout_gravity="end|bottom"
        android:id="@+id/mIvDownload"
        android:background="@mipmap/icon_downloadfinish"
        android:visibility="gone"
        android:layout_width="16dp"
        android:layout_height="16dp"/>
</com.zhy.autolayout.AutoFrameLayout>
