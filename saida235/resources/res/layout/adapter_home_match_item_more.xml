<?xml version="1.0" encoding="utf-8"?>
<com.zhy.autolayout.AutoFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.zhy.autolayout.AutoLinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/llMatchMore"
        android:background="@mipmap/bg_home_match_item_more"
        android:layout_width="156px"
        android:layout_height="232px"
        android:layout_marginLeft="12px"
        android:layout_marginRight="12px">
        <ImageView
            android:layout_width="48px"
            android:layout_height="48px"
            android:src="@mipmap/icon_home_match_item_more"/>
        <TextView
            android:textSize="20px"
            android:textColor="@color/color_ffffff"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8px"
            android:text="@string/home_match_empty_more"/>
    </com.zhy.autolayout.AutoLinearLayout>
</com.zhy.autolayout.AutoFrameLayout>
