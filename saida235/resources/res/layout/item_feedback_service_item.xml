<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/ivFeedback"
        android:background="@mipmap/whatapp_new"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginLeft="40dp"
        android:layout_marginTop="13dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/white"
        android:id="@+id/tvFeedback"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:text="@string/whatsapp"
        app:layout_constraintBottom_toBottomOf="@+id/ivFeedback"
        app:layout_constraintLeft_toRightOf="@+id/ivFeedback"
        app:layout_constraintTop_toTopOf="@+id/ivFeedback"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/color_ffaa00"
        android:id="@+id/tvFeedbackPhone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        app:layout_constraintBottom_toBottomOf="@+id/ivFeedback"
        app:layout_constraintLeft_toRightOf="@+id/tvFeedback"
        app:layout_constraintTop_toTopOf="@+id/ivFeedback"/>
    <TextView
        android:textSize="10sp"
        android:textColor="@color/color_b3b3b3"
        android:id="@+id/tvFeedbackTips"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="30dp"
        android:layout_marginTop="10dp"
        android:text=""
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ivFeedback"/>
</androidx.constraintlayout.widget.ConstraintLayout>
