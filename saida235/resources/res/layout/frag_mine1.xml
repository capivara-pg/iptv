<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/color_191a23"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/mAppBarLayout"
        android:background="@null"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.zhy.autolayout.AutoFrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_scrollFlags="snap|exitUntilCollapsed|scroll">
            <com.zhy.autolayout.AutoLinearLayout
                android:orientation="vertical"
                android:id="@+id/autoLinearLayout"
                android:background="@drawable/bg_mine_local_header"
                android:layout_width="match_parent"
                android:layout_height="165dp"
                app:layout_collapseMode="parallax">
                <com.zhy.autolayout.AutoRelativeLayout
                    android:id="@+id/mLayoutHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.zhy.autolayout.AutoRelativeLayout
                        android:id="@+id/mLayoutTop"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <ImageView
                            android:id="@+id/mImageScan"
                            android:layout_width="48px"
                            android:layout_height="48px"
                            android:layout_marginTop="20px"
                            android:layout_marginRight="20px"
                            android:src="@drawable/icon_mine_scan"
                            android:scaleType="fitXY"
                            android:layout_alignParentRight="true"/>
                        <com.zhy.autolayout.AutoFrameLayout
                            android:id="@+id/mIvMsgBox"
                            android:background="@drawable/ripper_common"
                            android:layout_width="48px"
                            android:layout_height="48px"
                            android:layout_marginTop="-3px"
                            android:layout_marginRight="40px"
                            android:layout_toLeftOf="@+id/mImageScan"
                            android:layout_alignTop="@+id/mImageScan">
                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:src="@drawable/ic_mine_msg_box"
                                android:scaleType="fitXY"/>
                        </com.zhy.autolayout.AutoFrameLayout>
                        <TextView
                            android:textSize="20px"
                            android:textColor="@color/color_important_white"
                            android:gravity="center"
                            android:id="@+id/mTvMsgCount"
                            android:background="@drawable/bg_red_dot_msg_box"
                            android:paddingLeft="4px"
                            android:paddingTop="1px"
                            android:paddingRight="4px"
                            android:paddingBottom="1px"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="34px"
                            android:layout_marginTop="-11px"
                            android:minWidth="32px"
                            android:singleLine="true"
                            android:layout_alignLeft="@+id/mIvMsgBox"
                            android:layout_alignTop="@+id/mIvMsgBox"/>
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="25px"
                            android:layout_marginTop="16px"
                            android:layout_below="@+id/mImageScan">
                            <com.zhy.autolayout.AutoLinearLayout
                                android:gravity="center"
                                android:id="@+id/mConAvatar"
                                android:background="@drawable/bg_mine_vip_back"
                                android:layout_width="60dp"
                                android:layout_height="60dp"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintTop_toTopOf="parent"/>
                            <ImageView
                                android:id="@+id/mImageAvatar"
                                android:layout_width="55dp"
                                android:layout_height="55dp"
                                android:src="@drawable/icon_mine_avatar"
                                android:scaleType="fitXY"
                                app:layout_constraintBottom_toBottomOf="@+id/mConAvatar"
                                app:layout_constraintLeft_toLeftOf="@+id/mConAvatar"
                                app:layout_constraintRight_toRightOf="@+id/mConAvatar"
                                app:layout_constraintTop_toTopOf="@+id/mConAvatar"/>
                            <ImageView
                                android:id="@+id/mImageCrown"
                                android:visibility="visible"
                                android:layout_width="48px"
                                android:layout_height="48px"
                                android:scaleType="fitCenter"
                                app:layout_constraintBottom_toBottomOf="@+id/mConAvatar"
                                app:layout_constraintRight_toRightOf="@+id/mConAvatar"/>
                            <com.zhy.autolayout.AutoLinearLayout
                                android:orientation="vertical"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="21px"
                                app:layout_constraintBottom_toBottomOf="@+id/mImageAvatar"
                                app:layout_constraintLeft_toRightOf="@+id/mImageAvatar"
                                app:layout_constraintTop_toTopOf="@+id/mImageAvatar">
                                <TextView
                                    android:textSize="36px"
                                    android:textColor="@color/ffffff"
                                    android:id="@+id/mTvUserName"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="123557893456"/>
                                <TextView
                                    android:textSize="20px"
                                    android:textColor="@color/color_aaaaaa"
                                    android:id="@+id/mTvUserId"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="10px"
                                    android:text="8013323"
                                    android:layout_below="@+id/mTvUserName"/>
                                <com.zhy.autolayout.AutoLinearLayout
                                    android:orientation="horizontal"
                                    android:id="@+id/mAllServiceWrapper"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_below="@+id/mTvUserId">
                                    <TextView
                                        android:textSize="10sp"
                                        android:textColor="@color/color_aaaaaa"
                                        android:gravity="bottom"
                                        android:id="@+id/mVipServiceHint"
                                        android:visibility="gone"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="10px"/>
                                    <ImageView
                                        android:id="@+id/mImageAuthInfoMore"
                                        android:paddingLeft="10px"
                                        android:paddingTop="10px"
                                        android:paddingRight="10px"
                                        android:paddingBottom="10px"
                                        android:visibility="gone"
                                        android:layout_width="49px"
                                        android:layout_height="49px"
                                        android:src="@drawable/icon_auth_info_more"
                                        android:scaleType="fitCenter"/>
                                </com.zhy.autolayout.AutoLinearLayout>
                            </com.zhy.autolayout.AutoLinearLayout>
                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </com.zhy.autolayout.AutoRelativeLayout>
                </com.zhy.autolayout.AutoRelativeLayout>
                <com.zhy.autolayout.AutoFrameLayout
                    android:orientation="vertical"
                    android:id="@+id/mAflBindHint"
                    android:background="@drawable/bg_mine_bind_hint"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="100px"
                    android:layout_marginLeft="22px"
                    android:layout_marginTop="-50px"
                    android:layout_marginRight="22px">
                    <TextView
                        android:textSize="15sp"
                        android:textColor="@color/color_fefefe"
                        android:gravity="center_vertical"
                        android:id="@+id/mTvBindAndGainFree"
                        android:paddingLeft="48px"
                        android:paddingRight="134px"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="@string/mine_bind_and_gain_free"/>
                    <ImageView
                        android:layout_gravity="center"
                        android:id="@+id/mIvGoBind"
                        android:layout_width="85px"
                        android:layout_height="85px"
                        android:layout_marginRight="10px"
                        android:src="@drawable/ic_mine_go_bind"/>
                </com.zhy.autolayout.AutoFrameLayout>
                <com.zhy.autolayout.AutoLinearLayout
                    android:orientation="vertical"
                    android:id="@+id/mAlVip"
                    android:background="@drawable/icon_mine_vip_back"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="54px"
                    android:layout_marginTop="30dp"
                    android:layout_marginRight="54px">
                    <TextView
                        android:textSize="28px"
                        android:textColor="@color/color_FFB0B0B0"
                        android:gravity="center"
                        android:id="@+id/mTvVip"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text=""/>
                    <ImageView
                        android:layout_gravity="center"
                        android:id="@+id/mIvVip"
                        android:background="@mipmap/icon_vip_up"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5px"
                        android:layout_marginBottom="5px"/>
                </com.zhy.autolayout.AutoLinearLayout>
            </com.zhy.autolayout.AutoLinearLayout>
            <TextView
                android:textSize="16sp"
                android:textStyle="italic|bold"
                android:textColor="@color/color_ffffff"
                android:gravity="center"
                android:id="@+id/mCollapsingTitle"
                android:background="@color/color_2c2d39"
                android:layout_width="match_parent"
                android:layout_height="62dp"
                android:text="@string/nav_button_mine"
                app:layout_collapseMode="pin"/>
        </com.zhy.autolayout.AutoFrameLayout>&gt; 
    </com.google.android.material.appbar.AppBarLayout>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/mNestedScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/mAflBindHint"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">
        <com.zhy.autolayout.AutoLinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.zhy.autolayout.AutoLinearLayout
                android:orientation="horizontal"
                android:id="@+id/mAllVipAndInvite"
                android:background="@color/color_2c2d39"
                android:paddingTop="40px"
                android:layout_width="match_parent"
                android:layout_height="156px">
                <com.zhy.autolayout.AutoLinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:id="@+id/mAflJoinVip"
                    android:background="@drawable/bg_mine_join_vip"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="30px"
                    android:layout_weight="1">
                    <TextView
                        android:textSize="32px"
                        android:textColor="@color/color_ffffff"
                        android:id="@+id/mTvJoinVip"
                        android:paddingLeft="11px"
                        android:paddingRight="20px"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/mine_join_vip"/>
                    <TextView
                        android:textSize="24px"
                        android:textColor="@color/color_fae94b"
                        android:gravity="center_vertical"
                        android:id="@+id/mTvJoinVipDesc"
                        android:paddingLeft="11px"
                        android:paddingRight="20px"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/mine_go_withdraw"/>
                </com.zhy.autolayout.AutoLinearLayout>
                <View
                    android:id="@+id/mVVipAndInvite"
                    android:layout_width="30px"
                    android:layout_height="match_parent"/>
                <com.zhy.autolayout.AutoLinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:id="@+id/mInviteFriendWrapper"
                    android:background="@drawable/bg_mine_invite_friend"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginRight="30px"
                    android:layout_weight="1">
                    <TextView
                        android:textSize="32px"
                        android:textColor="@color/color_important_white"
                        android:id="@+id/mTvInviteFriend"
                        android:paddingLeft="11px"
                        android:paddingRight="20px"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/mine_invite_friend"/>
                    <TextView
                        android:textSize="24px"
                        android:textColor="@color/color_fae94b"
                        android:gravity="center_vertical"
                        android:id="@+id/mTvWithdraw"
                        android:paddingLeft="11px"
                        android:paddingRight="20px"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/mine_go_withdraw"/>
                </com.zhy.autolayout.AutoLinearLayout>
            </com.zhy.autolayout.AutoLinearLayout>
            <com.zhy.autolayout.AutoLinearLayout
                android:orientation="horizontal"
                android:id="@+id/mLayoutFavAndHistory"
                android:background="@color/color_2c2d39"
                android:layout_width="match_parent"
                android:layout_height="144px">
                <com.zhy.autolayout.AutoLinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:id="@+id/mLayoutFav"
                    android:layout_width="350px"
                    android:layout_height="match_parent"
                    android:layout_weight="1">
                    <ImageView
                        android:layout_width="56px"
                        android:layout_height="56px"
                        android:src="@drawable/icon_mine_fav"
                        android:scaleType="fitXY"/>
                    <TextView
                        android:textSize="30px"
                        android:textColor="@color/ffffff"
                        android:gravity="center"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="15px"
                        android:text="@string/mine_fav"/>
                </com.zhy.autolayout.AutoLinearLayout>
                <View
                    android:layout_gravity="center_vertical"
                    android:background="@color/color_21FFFFFF"
                    android:layout_width="1px"
                    android:layout_height="56px"/>
                <com.zhy.autolayout.AutoLinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:id="@+id/mLayoutHistory"
                    android:layout_width="350px"
                    android:layout_height="match_parent"
                    android:layout_weight="1">
                    <ImageView
                        android:layout_width="56px"
                        android:layout_height="56px"
                        android:src="@drawable/icon_mine_history"
                        android:scaleType="fitXY"/>
                    <TextView
                        android:textSize="30px"
                        android:textColor="@color/ffffff"
                        android:gravity="center"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="15px"
                        android:text="@string/mine_history"/>
                </com.zhy.autolayout.AutoLinearLayout>
                <View
                    android:layout_gravity="center_vertical"
                    android:background="@color/color_21FFFFFF"
                    android:layout_width="1px"
                    android:layout_height="56px"/>
                <com.zhy.autolayout.AutoLinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:id="@+id/mLayoutDownload"
                    android:layout_width="350px"
                    android:layout_height="match_parent"
                    android:layout_weight="1">
                    <ImageView
                        android:layout_width="56px"
                        android:layout_height="56px"
                        android:src="@drawable/icon_mine_download"
                        android:scaleType="fitXY"/>
                    <TextView
                        android:textSize="30px"
                        android:textColor="@color/ffffff"
                        android:gravity="center"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="15px"
                        android:text="@string/mine_download"/>
                </com.zhy.autolayout.AutoLinearLayout>
            </com.zhy.autolayout.AutoLinearLayout>
            <com.zhy.autolayout.AutoLinearLayout
                android:layout_gravity="center_horizontal"
                android:orientation="vertical"
                android:id="@+id/mLayoutOption1"
                android:background="@color/color_2c2d39"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12px">
                <com.mobile.brasiltv.view.setting.MenuItem
                    android:id="@+id/mLayoutAccount"
                    android:layout_width="match_parent"
                    android:layout_height="105px"
                    app:menuIcon="@drawable/icon_mine_account"
                    app:menuName="@string/mine_account"
                    app:menuRightIcon="@drawable/icon_mine_arrow"/>
                <com.mobile.brasiltv.view.setting.MenuItem
                    android:id="@+id/mLayoutPlayList"
                    android:layout_width="match_parent"
                    android:layout_height="105px"
                    app:menuIcon="@drawable/icon_mine_playlist"
                    app:menuName="@string/playlist_title"
                    app:menuRightIcon="@drawable/icon_mine_arrow"/>
                <com.mobile.brasiltv.view.setting.MenuItem
                    android:id="@+id/mLayoutOrder"
                    android:layout_width="match_parent"
                    android:layout_height="105px"
                    app:menuIcon="@drawable/icon_mine_order"
                    app:menuName="@string/mine_order"
                    app:menuRightIcon="@drawable/icon_mine_arrow"/>
                <com.mobile.brasiltv.view.setting.MenuItem
                    android:id="@+id/mLayoutReward"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="105px"
                    app:menuIcon="@drawable/ic_menu_activity"
                    app:menuName="@string/mine_reward_center"
                    app:menuRightIcon="@drawable/icon_mine_arrow"/>
                <com.mobile.brasiltv.view.setting.MenuItem
                    android:id="@+id/mMiBenefit"
                    android:layout_width="match_parent"
                    android:layout_height="105px"
                    app:menuIcon="@drawable/ic_menu_benefit"
                    app:menuName="@string/mine_menu_benefit"
                    app:menuRightIcon="@drawable/icon_mine_arrow"/>
                <com.mobile.brasiltv.view.setting.MenuSwitchItem
                    android:id="@+id/mLayoutBlock"
                    android:background="@drawable/bg_mine_menu"
                    android:layout_width="match_parent"
                    android:layout_height="105px"
                    app:menuSwitchIcon="@drawable/icon_mine_block"
                    app:menuSwitchName="@string/mine_block"
                    app:menuSwitchSelector="@drawable/selector_switch_block"/>
                <com.mobile.brasiltv.view.setting.MenuItem
                    android:id="@+id/mLayoutLanguage"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="90px"
                    app:menuIcon="@drawable/icon_mine_language"
                    app:menuName="@string/mine_language"
                    app:menuRightIcon="@drawable/icon_mine_arrow"/>
            </com.zhy.autolayout.AutoLinearLayout>
            <com.zhy.autolayout.AutoLinearLayout
                android:layout_gravity="center_horizontal"
                android:orientation="vertical"
                android:id="@+id/mLayoutOption2"
                android:background="@color/color_2c2d39"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12px"
                android:layout_marginBottom="24px">
                <com.mobile.brasiltv.view.setting.MenuItem
                    android:id="@+id/mLayoutSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="105px"
                    app:menuIcon="@drawable/ic_menu_subtitle"
                    app:menuName="@string/mine_subtitle_audio"
                    app:menuRightIcon="@drawable/icon_mine_arrow"/>
                <com.mobile.brasiltv.view.setting.MenuItem
                    android:id="@+id/mLayoutHelp"
                    android:layout_width="match_parent"
                    android:layout_height="105px"
                    app:menuIcon="@drawable/icon_mine_help"
                    app:menuName="@string/mine_help"
                    app:menuRightIcon="@drawable/icon_mine_arrow"/>
                <com.mobile.brasiltv.view.setting.MenuItem
                    android:id="@+id/mLayoutSetting"
                    android:layout_width="match_parent"
                    android:layout_height="105px"
                    app:menuIcon="@drawable/ic_menu_setting"
                    app:menuName="@string/mine_setting"
                    app:menuRightIcon="@drawable/icon_mine_arrow"/>
                <com.mobile.brasiltv.view.setting.MenuItem
                    android:id="@+id/mLayoutShareApp"
                    android:layout_width="match_parent"
                    android:layout_height="105px"
                    app:menuIcon="@drawable/ic_menu_share"
                    app:menuName="@string/mine_share_app"
                    app:menuRightIcon="@drawable/icon_mine_arrow"/>
            </com.zhy.autolayout.AutoLinearLayout>
        </com.zhy.autolayout.AutoLinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
