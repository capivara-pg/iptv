<?xml version="1.0" encoding="utf-8"?>
<com.zhy.autolayout.AutoRelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mMatchControl"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.mobile.brasiltv.view.AutoHideRelativeLayout
        android:id="@+id/mMatchControlPanelLandscape"
        android:background="@drawable/bg_play_fullscreen_shadow"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/mIconBack"
            android:padding="20px"
            android:layout_width="88px"
            android:layout_height="128px"
            android:src="@drawable/ic_match_back"
            android:scaleType="centerInside"/>
        <TextView
            android:textSize="32px"
            android:textColor="@color/white"
            android:ellipsize="end"
            android:id="@+id/mTvMatchName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30px"
            android:maxWidth="510px"
            android:singleLine="true"
            android:layout_toRightOf="@+id/mIconBack"/>
        <TextView
            android:textSize="24px"
            android:textColor="@color/color_ffffff"
            android:id="@+id/mTvTeam"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6px"
            android:singleLine="true"
            android:layout_toRightOf="@+id/mIconBack"
            android:layout_below="@+id/mTvMatchName"/>
        <com.zhy.autolayout.AutoLinearLayout
            android:orientation="horizontal"
            android:id="@+id/llMenu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true">
            <ImageView
                android:id="@+id/mDebugSwitch_lands"
                android:visibility="gone"
                android:layout_width="48px"
                android:layout_height="48px"
                android:layout_marginTop="40px"
                android:layout_marginRight="50px"
                android:src="@mipmap/close"
                android:scaleType="fitCenter"/>
            <ImageView
                android:id="@+id/mIvSwitchChannel"
                android:visibility="gone"
                android:layout_width="48px"
                android:layout_height="48px"
                android:layout_marginTop="40px"
                android:layout_marginRight="50px"
                android:src="@drawable/ic_switch_channel"/>
            <ImageView
                android:id="@+id/mImageLandFeedback"
                android:layout_width="48px"
                android:layout_height="48px"
                android:layout_marginTop="40px"
                android:layout_marginRight="50px"
                android:src="@drawable/ic_feedback"/>
            <ImageView
                android:id="@+id/mIconCast"
                android:visibility="gone"
                android:layout_width="48px"
                android:layout_height="48px"
                android:layout_marginTop="40px"
                android:layout_marginRight="40px"
                android:src="@drawable/icon_cast"/>
            <ImageView
                android:id="@+id/mImageScreen"
                android:visibility="gone"
                android:layout_width="48px"
                android:layout_height="48px"
                android:layout_marginTop="40px"
                android:layout_marginRight="25px"
                android:src="@drawable/ic_screen"/>
        </com.zhy.autolayout.AutoLinearLayout>
        <com.zhy.autolayout.AutoLinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="82px"
            android:layout_marginRight="48px"
            android:layout_marginBottom="20px"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true">
            <com.zhy.autolayout.AutoLinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/mLlLock"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="match_parent">
                <ImageView
                    android:layout_width="48px"
                    android:layout_height="48px"
                    android:src="@drawable/ic_unlock"/>
                <TextView
                    android:textSize="28px"
                    android:textColor="@color/color_important_white"
                    android:gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10px"
                    android:text="@string/live_lock"/>
            </com.zhy.autolayout.AutoLinearLayout>
            <com.zhy.autolayout.AutoLinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/mLlQuality"
                android:focusable="true"
                android:visibility="gone"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginLeft="120px">
                <ImageView
                    android:id="@+id/mIvLandQuality"
                    android:layout_width="48px"
                    android:layout_height="48px"
                    android:src="@drawable/ic_quality_480p"/>
                <TextView
                    android:textSize="28px"
                    android:textColor="@color/color_important_white"
                    android:gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10px"
                    android:text="@string/live_quality"/>
            </com.zhy.autolayout.AutoLinearLayout>
        </com.zhy.autolayout.AutoLinearLayout>
        <include layout="@layout/layout_brightness_controller"/>
        <include layout="@layout/layout_volume_controller"/>
    </com.mobile.brasiltv.view.AutoHideRelativeLayout>
    <com.zhy.autolayout.AutoFrameLayout
        android:id="@+id/mFlLocked"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="120px"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true">
        <ImageView
            android:layout_gravity="center_horizontal"
            android:padding="25px"
            android:layout_width="100px"
            android:layout_height="100px"
            android:src="@drawable/ic_locked"/>
        <TextView
            android:textSize="28px"
            android:textColor="@color/color_important_white"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="116px"
            android:text="@string/live_unlock"/>
    </com.zhy.autolayout.AutoFrameLayout>
</com.zhy.autolayout.AutoRelativeLayout>
