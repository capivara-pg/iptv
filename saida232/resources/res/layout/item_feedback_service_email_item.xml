<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/ivEmails"
        android:background="@mipmap/icon_feedback_email"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginLeft="30dp"
        android:layout_marginTop="13dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/white"
        android:id="@+id/tvEmails"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:text="@string/email"
        app:layout_constraintBottom_toBottomOf="@+id/ivEmails"
        app:layout_constraintLeft_toRightOf="@+id/ivEmails"
        app:layout_constraintTop_toTopOf="@+id/ivEmails"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/color_secondary_text"
        android:id="@+id/tvFeedbackEmail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:text="@string/customer_service_feedback"
        app:layout_constraintLeft_toLeftOf="@+id/ivEmails"
        app:layout_constraintTop_toBottomOf="@+id/ivEmails"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/white"
        android:id="@+id/tvEmailTips"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        app:layout_constraintBottom_toBottomOf="@+id/tvFeedbackEmail"
        app:layout_constraintLeft_toRightOf="@+id/tvFeedbackEmail"
        app:layout_constraintTop_toTopOf="@+id/tvFeedbackEmail"/>
    <ImageView
        android:id="@+id/ivCopy"
        android:background="@mipmap/icon_copy_feedback"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/tvFeedbackEmail"
        app:layout_constraintLeft_toRightOf="@+id/tvEmailTips"
        app:layout_constraintTop_toTopOf="@+id/tvFeedbackEmail"/>
</androidx.constraintlayout.widget.ConstraintLayout>
