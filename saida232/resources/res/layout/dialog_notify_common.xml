<?xml version="1.0" encoding="utf-8"?>
<com.zhy.autolayout.AutoLinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:id="@+id/mAllRoot"
    android:background="@drawable/bg_dialog_notify"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="40px"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:layout_gravity="center_horizontal"
        android:id="@+id/mTvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="48px"
        android:text="@string/dialog_title_notify"
        android:includeFontPadding="false"/>
    <TextView
        android:textSize="32px"
        android:textColor="@color/color_8D8E91"
        android:gravity="center"
        android:id="@+id/mTvDesc"
        android:paddingLeft="48px"
        android:paddingRight="48px"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16px"
        android:layout_below="@+id/mTextTitle"/>
    <TextView
        android:textSize="32px"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/mTvConfirm"
        android:background="@drawable/bg_filter_cond_enable"
        android:layout_width="match_parent"
        android:layout_height="88px"
        android:layout_marginLeft="90px"
        android:layout_marginTop="48px"
        android:layout_marginRight="90px"
        android:text="@string/confirm"/>
    <TextView
        android:textSize="32px"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/mTvCancel"
        android:background="@drawable/bg_common_cancel"
        android:layout_width="match_parent"
        android:layout_height="88px"
        android:layout_marginLeft="90px"
        android:layout_marginTop="32px"
        android:layout_marginRight="90px"
        android:layout_marginBottom="64px"
        android:text="@string/cancel"/>
</com.zhy.autolayout.AutoLinearLayout>
