<?xml version="1.0" encoding="utf-8"?>
<com.zhy.autolayout.AutoFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/color_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.zhy.autolayout.AutoLinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.mobile.brasiltv.view.LiveStreamTitleView
            android:id="@+id/title_view"
            android:layout_width="match_parent"
            android:layout_height="128px"/>
        <com.zhy.autolayout.AutoLinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="10px">
            <com.zhy.autolayout.AutoFrameLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="394px"
                android:layout_marginLeft="30px"
                android:layout_marginRight="30px">
                <com.mobile.brasiltv.view.bannerview.BannerViewPager
                    android:id="@+id/bannerLivestream"
                    android:layout_width="match_parent"
                    android:layout_height="394px"/>
                <View
                    android:layout_gravity="bottom"
                    android:background="@drawable/livestream_more_back"
                    android:layout_width="match_parent"
                    android:layout_height="150px"/>
                <com.zhpan.indicator.IndicatorView
                    android:layout_gravity="bottom|center_horizontal"
                    android:id="@+id/indicatorView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16px"/>
            </com.zhy.autolayout.AutoFrameLayout>
            <androidx.core.widget.NestedScrollView
                android:id="@+id/mScrollView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="29px">
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/mRvStream"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="15dp"
                    android:layout_marginRight="15dp"/>
            </androidx.core.widget.NestedScrollView>
        </com.zhy.autolayout.AutoLinearLayout>
    </com.zhy.autolayout.AutoLinearLayout>
    <ImageView
        android:id="@+id/ivPlacehold"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="394px"
        android:layout_marginLeft="30px"
        android:layout_marginTop="138px"
        android:layout_marginRight="30px"
        android:scaleType="fitXY"/>
    <com.mobile.brasiltv.view.KoocanEmptyView
        android:id="@+id/mLoadingView"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:emptyShowType="loading"/>
</com.zhy.autolayout.AutoFrameLayout>
