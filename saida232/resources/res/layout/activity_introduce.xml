<?xml version="1.0" encoding="utf-8"?>
<com.zhy.autolayout.AutoRelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.viewpager.widget.ViewPager
        android:id="@+id/mViewPager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/mLayoutPoint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="230px"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="40px"
        android:layout_alignParentStart="true"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/color_6a6a6a"
        android:gravity="center"
        android:id="@+id/mTextIntroduceSecond"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="80px"
        android:layout_marginTop="10px"
        android:layout_marginRight="80px"
        android:layout_marginBottom="190px"
        android:layout_above="@+id/mLayoutPoint"/>
    <TextView
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/color_ffffff"
        android:gravity="center"
        android:id="@+id/mTextIntroduceFirst"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="80px"
        android:layout_marginTop="124px"
        android:layout_marginRight="80px"
        android:layout_above="@+id/mTextIntroduceSecond"
        android:layout_centerHorizontal="true"/>
    <ImageView
        android:id="@+id/mIvNext"
        android:visibility="gone"
        android:layout_width="116px"
        android:layout_height="116px"
        android:layout_marginBottom="180px"
        android:src="@drawable/ic_introduce_next"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="32px"
        android:layout_alignParentEnd="true"/>
    <TextView
        android:textSize="36px"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/mButtonEnter"
        android:background="@drawable/bg_btn_introduce_start"
        android:paddingLeft="36px"
        android:paddingRight="36px"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="80px"
        android:layout_marginBottom="196px"
        android:text="@string/experience_now"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="50px"
        android:layout_alignParentEnd="true"/>
</com.zhy.autolayout.AutoRelativeLayout>
