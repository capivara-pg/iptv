<?xml version="1.0" encoding="utf-8"?>
<com.zhy.autolayout.AutoRelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/bg_match_play_window"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/mIconHintBack"
        android:layout_width="48px"
        android:layout_height="48px"
        android:layout_marginLeft="16px"
        android:layout_marginTop="24px"
        android:src="@drawable/ic_match_back"/>
    <TextView
        android:textSize="28px"
        android:textColor="@color/color_ffffff"
        android:gravity="center"
        android:id="@+id/mTvStatus"
        android:paddingLeft="60px"
        android:paddingRight="60px"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/match_hint_content_unavailable"
        android:layout_centerInParent="true"/>
    <com.zhy.autolayout.AutoLinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/mLlCountDown"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true">
        <TextView
            android:textSize="32px"
            android:textColor="@color/color_ffffff"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="30px"
            android:text="@string/match_hint_until_begin"/>
        <com.zhy.autolayout.AutoLinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <com.zhy.autolayout.AutoFrameLayout
                android:layout_width="94px"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="50px"
                    android:textColor="@color/color_important_white"
                    android:gravity="center"
                    android:id="@+id/mTvDayFirst"
                    android:background="@drawable/bg_match_count_down"
                    android:layout_width="46px"
                    android:layout_height="68px"/>
                <TextView
                    android:textSize="50px"
                    android:textColor="@color/color_important_white"
                    android:gravity="center"
                    android:id="@+id/mTvDaySecond"
                    android:background="@drawable/bg_match_count_down"
                    android:layout_width="46px"
                    android:layout_height="68px"
                    android:layout_marginLeft="48px"/>
                <TextView
                    android:textSize="24px"
                    android:textColor="@color/color_ffffff"
                    android:gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="32px"
                    android:layout_marginTop="74px"
                    android:text="@string/match_count_down_days"/>
            </com.zhy.autolayout.AutoFrameLayout>
            <TextView
                android:textSize="50px"
                android:textColor="@color/color_important_white"
                android:gravity="center"
                android:layout_width="58px"
                android:layout_height="66px"
                android:layout_marginTop="-10px"
                android:text=":"/>
            <com.zhy.autolayout.AutoFrameLayout
                android:layout_width="94px"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="50px"
                    android:textColor="@color/color_important_white"
                    android:gravity="center"
                    android:id="@+id/mTvHourFirst"
                    android:background="@drawable/bg_match_count_down"
                    android:layout_width="46px"
                    android:layout_height="68px"/>
                <TextView
                    android:textSize="50px"
                    android:textColor="@color/color_important_white"
                    android:gravity="center"
                    android:id="@+id/mTvHourSecond"
                    android:background="@drawable/bg_match_count_down"
                    android:layout_width="46px"
                    android:layout_height="68px"
                    android:layout_marginLeft="48px"/>
                <TextView
                    android:textSize="24px"
                    android:textColor="@color/ffffff"
                    android:gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="32px"
                    android:layout_marginTop="74px"
                    android:text="@string/match_count_down_hours"/>
            </com.zhy.autolayout.AutoFrameLayout>
            <TextView
                android:textSize="50px"
                android:textColor="@color/color_important_white"
                android:gravity="center"
                android:layout_width="58px"
                android:layout_height="66px"
                android:layout_marginTop="-10px"
                android:text=":"/>
            <com.zhy.autolayout.AutoFrameLayout
                android:layout_width="94px"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="50px"
                    android:textColor="@color/color_important_white"
                    android:gravity="center"
                    android:id="@+id/mTvMinuteFirst"
                    android:background="@drawable/bg_match_count_down"
                    android:layout_width="46px"
                    android:layout_height="68px"/>
                <TextView
                    android:textSize="50px"
                    android:textColor="@color/color_important_white"
                    android:gravity="center"
                    android:id="@+id/mTvMinuteSecond"
                    android:background="@drawable/bg_match_count_down"
                    android:layout_width="46px"
                    android:layout_height="68px"
                    android:layout_marginLeft="48px"/>
                <TextView
                    android:textSize="24px"
                    android:textColor="@color/color_ffffff"
                    android:gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="32px"
                    android:layout_marginTop="74px"
                    android:text="@string/match_count_down_minutes"/>
            </com.zhy.autolayout.AutoFrameLayout>
        </com.zhy.autolayout.AutoLinearLayout>
    </com.zhy.autolayout.AutoLinearLayout>
</com.zhy.autolayout.AutoRelativeLayout>
