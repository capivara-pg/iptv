<?xml version="1.0" encoding="utf-8"?>
<com.zhy.autolayout.AutoFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/bg_match_notify_dialog"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="64px"
    android:layout_marginRight="64px">
    <TextView
        android:textSize="28px"
        android:textColor="@color/color_ffffff"
        android:layout_gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="38px"
        android:text="@string/match_game_will_start"/>
    <ImageView
        android:layout_gravity="end|top"
        android:id="@+id/ivClose"
        android:layout_width="48px"
        android:layout_height="48px"
        android:layout_marginTop="32px"
        android:layout_marginRight="22px"
        android:src="@mipmap/icon_match_league_dialog_close"/>
    <androidx.recyclerview.widget.RecyclerView
        android:scrollbarSize="3dp"
        android:scrollbarThumbVertical="@drawable/shape_scrollbar_thumb"
        android:scrollbarStyle="outsideInset"
        android:id="@+id/mRvMatch"
        android:scrollbars="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12px"
        android:layout_marginTop="114px"
        android:layout_marginRight="12px"
        android:layout_marginBottom="30px"
        android:scrollbarFadeDuration="0"
        android:fadeScrollbars="false"/>
</com.zhy.autolayout.AutoFrameLayout>
