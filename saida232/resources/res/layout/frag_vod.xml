<?xml version="1.0" encoding="utf-8"?>
<com.zhy.autolayout.AutoFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/mLayoutVodRoot"
    android:background="@color/color_FF1C1D23"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.mobile.brasiltv.view.NoScrollViewPager
        android:id="@+id/mRecommendVp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="260px"/>
    <com.zhy.autolayout.AutoLinearLayout
        android:orientation="vertical"
        android:id="@+id/mLayoutNavigator"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.zhy.autolayout.AutoRelativeLayout
            android:id="@+id/mLayoutTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:gravity="center"
                android:id="@+id/mCinemaTitle"
                android:layout_width="100px"
                android:layout_height="88px"
                android:layout_marginLeft="30px"
                android:layout_marginTop="65px"
                android:src="@mipmap/icon_home_logo"/>
            <com.zhy.autolayout.AutoRelativeLayout
                android:id="@+id/mReSearch"
                android:background="@drawable/bg_home_search_c6d6ff"
                android:layout_width="0dp"
                android:layout_height="72px"
                android:layout_marginLeft="24px"
                android:layout_marginTop="75px"
                android:layout_marginRight="14px"
                android:layout_toLeftOf="@+id/mIvGameCenter"
                android:layout_toRightOf="@+id/mCinemaTitle">
                <ImageView
                    android:id="@+id/mVodImageSearch"
                    android:background="@drawable/icon_home_search"
                    android:layout_width="36px"
                    android:layout_height="36px"
                    android:layout_marginLeft="16px"
                    android:layout_centerVertical="true"/>
                <TextView
                    android:textSize="28px"
                    android:textColor="@color/color_5EFFFFFF"
                    android:ellipsize="end"
                    android:id="@+id/mVodSearch"
                    android:background="@drawable/ripper_common"
                    android:paddingLeft="65px"
                    android:paddingRight="90px"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/search_for_content_title"
                    android:singleLine="true"
                    android:layout_centerVertical="true"/>
                <ImageView
                    android:id="@+id/mVodImageFilter"
                    android:paddingLeft="5px"
                    android:paddingTop="5px"
                    android:paddingRight="5px"
                    android:paddingBottom="5px"
                    android:visibility="visible"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@mipmap/icon_filter"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"/>
                <View
                    android:id="@+id/mVodFilterSplit"
                    android:background="@color/white"
                    android:visibility="visible"
                    android:layout_width="1px"
                    android:layout_height="34px"
                    android:layout_marginTop="19px"
                    android:layout_toLeftOf="@+id/mVodImageFilter"
                    android:alpha="0.34"/>
            </com.zhy.autolayout.AutoRelativeLayout>
            <ImageView
                android:id="@+id/mIvGameCenter"
                android:background="@mipmap/icon_vod_customer_service"
                android:visibility="visible"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginTop="8px"
                android:layout_marginRight="42px"
                android:layout_alignTop="@+id/mReSearch"
                android:layout_alignParentEnd="true"/>
        </com.zhy.autolayout.AutoRelativeLayout>
        <ImageView
            android:id="@+id/mIvTitleLine"
            android:background="@color/color_1f202a"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="1px"/>
        <com.flyco.tablayout.SlidingTabLayout
            android:id="@+id/mRecommendTab"
            android:paddingLeft="5dp"
            android:paddingRight="5dp"
            android:layout_width="match_parent"
            android:layout_height="62px"
            android:layout_marginTop="10px"
            android:layout_marginBottom="25px"
            app:tl_indicator_color="@color/color_important"
            app:tl_indicator_corner_radius="5dp"
            app:tl_indicator_height="3dp"
            app:tl_indicator_style="NORMAL"
            app:tl_indicator_width="19dp"
            app:tl_textBold="BOTH"
            app:tl_textSelectColor="@color/color_important"
            app:tl_textsize="16sp"/>
    </com.zhy.autolayout.AutoLinearLayout>
    <com.mobile.brasiltv.view.KoocanEmptyView
        android:id="@+id/vod_loadingView"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="129px"
        app:emptyShowType="loading"/>
</com.zhy.autolayout.AutoFrameLayout>
