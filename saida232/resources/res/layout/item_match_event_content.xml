<?xml version="1.0" encoding="utf-8"?>
<com.zhy.autolayout.AutoRelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:background="@color/color_3d3d46"
        android:layout_width="2px"
        android:layout_height="54px"
        android:layout_below="@+id/tvTime"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textSize="24px"
        android:textColor="@color/color_ffffff"
        android:gravity="center"
        android:id="@+id/tvTime"
        android:background="@drawable/bg_match_event_item"
        android:layout_width="72px"
        android:layout_height="72px"
        android:layout_centerHorizontal="true"/>
    <com.zhy.autolayout.AutoFrameLayout
        android:id="@+id/mLayoutTeamA"
        android:layout_width="242px"
        android:layout_height="70px"
        android:layout_toLeftOf="@+id/tvTime">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/ivIconA"
            android:layout_width="36px"
            android:layout_height="36px"
            android:layout_marginRight="8px"
            android:scaleType="centerInside"/>
        <TextView
            android:textSize="24px"
            android:textColor="@color/color_AEAFB3"
            android:ellipsize="end"
            android:gravity="right"
            android:layout_gravity="center"
            android:id="@+id/tvNameA"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginRight="50px"
            android:maxLines="2"/>
    </com.zhy.autolayout.AutoFrameLayout>
    <com.zhy.autolayout.AutoFrameLayout
        android:id="@+id/mLayoutTeamB"
        android:layout_width="242px"
        android:layout_height="70px"
        android:layout_toRightOf="@+id/tvTime">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/ivIconB"
            android:layout_width="36px"
            android:layout_height="36px"
            android:layout_marginLeft="8px"
            android:scaleType="centerInside"/>
        <TextView
            android:textSize="24px"
            android:textColor="@color/color_AEAFB3"
            android:ellipsize="end"
            android:gravity="left"
            android:layout_gravity="center"
            android:id="@+id/tvNameB"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="50px"
            android:maxLines="2"/>
    </com.zhy.autolayout.AutoFrameLayout>
</com.zhy.autolayout.AutoRelativeLayout>
