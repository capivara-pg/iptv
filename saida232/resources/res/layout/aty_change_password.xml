<?xml version="1.0" encoding="utf-8"?>
<com.zhy.autolayout.AutoRelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/color_1f2029"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.mobile.brasiltv.view.TitleView
        android:id="@+id/title_view"
        android:background="@color/color_191a23"
        android:layout_width="match_parent"
        android:layout_height="128px"
        app:titleViewTitle="@string/change_password"/>
    <com.zhy.autolayout.AutoRelativeLayout
        android:id="@+id/mLayoutChange"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/title_view">
        <com.zhy.autolayout.AutoLinearLayout
            android:orientation="horizontal"
            android:id="@+id/mLayoutOldPassword"
            android:background="@color/color_2c2d39"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="90px"
            android:layout_marginTop="15px">
            <EditText
                android:textSize="30px"
                android:textColor="@color/color_999999"
                android:textColorHint="@color/color_999999"
                android:gravity="center_vertical"
                android:id="@+id/mEditOldPassword"
                android:background="@null"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginLeft="26px"
                android:layout_marginRight="82px"
                android:hint="@string/input_old_password"
                android:singleLine="true"/>
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/mImageEye"
                android:layout_width="37px"
                android:layout_height="37px"
                android:layout_marginLeft="-62px"
                android:src="@drawable/icon_hide_password"
                android:scaleType="center"/>
        </com.zhy.autolayout.AutoLinearLayout>
        <EditText
            android:textSize="30px"
            android:textColor="@color/color_999999"
            android:textColorHint="@color/color_999999"
            android:gravity="center_vertical"
            android:id="@+id/mEditNewPassword"
            android:background="@color/color_2c2d39"
            android:paddingLeft="26px"
            android:layout_width="match_parent"
            android:layout_height="90px"
            android:layout_marginTop="2px"
            android:hint="@string/new_password_limit"
            android:singleLine="true"
            android:layout_below="@+id/mLayoutOldPassword"/>
        <EditText
            android:textSize="30px"
            android:textColor="@color/color_999999"
            android:textColorHint="@color/color_999999"
            android:gravity="center_vertical"
            android:id="@+id/mEditPasswordAgain"
            android:background="@color/color_2c2d39"
            android:paddingLeft="26px"
            android:layout_width="match_parent"
            android:layout_height="90px"
            android:layout_marginTop="2px"
            android:hint="@string/input_password_again"
            android:singleLine="true"
            android:layout_below="@+id/mEditNewPassword"/>
        <TextView
            android:textSize="30px"
            android:textColor="@color/ffffff"
            android:gravity="center"
            android:id="@+id/mTextConfirm"
            android:background="@drawable/icon_mine_button"
            android:layout_width="702px"
            android:layout_height="80px"
            android:layout_marginTop="105px"
            android:text="@string/confirm"
            android:layout_below="@+id/mEditPasswordAgain"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textSize="26px"
            android:textColor="@color/color_important"
            android:id="@+id/mTextForgetPassword"
            android:paddingTop="15px"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20px"
            android:layout_marginRight="26px"
            android:text="@string/login_forget_pwd"
            android:layout_below="@+id/mTextConfirm"
            android:layout_alignParentRight="true"/>
        <TextView
            android:textSize="26px"
            android:textColor="@color/color_f23232"
            android:gravity="center"
            android:id="@+id/mTextErrorNotify"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="60px"
            android:text="Wrong password, please re-enter!"
            android:layout_below="@+id/mTextForgetPassword"
            android:layout_centerHorizontal="true"/>
    </com.zhy.autolayout.AutoRelativeLayout>
    <com.zhy.autolayout.AutoLinearLayout
        android:orientation="vertical"
        android:id="@+id/mLayoutSuccess"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/title_view">
        <ImageView
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="141px"
            android:src="@drawable/icon_change_password"/>
        <TextView
            android:textSize="26px"
            android:textColor="@color/ffffff"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="60px"
            android:layout_marginTop="95px"
            android:layout_marginRight="60px"
            android:text="@string/change_password_success"/>
    </com.zhy.autolayout.AutoLinearLayout>
</com.zhy.autolayout.AutoRelativeLayout>
