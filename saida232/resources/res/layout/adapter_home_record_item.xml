<?xml version="1.0" encoding="utf-8"?>
<com.zhy.autolayout.AutoLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/mLinearLayout"
    android:clickable="true"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginRight="24px">
    <com.mobile.brasiltv.view.AutoCardView
        android:orientation="vertical"
        android:id="@+id/mLayout"
        android:clickable="true"
        android:layout_width="268px"
        android:layout_height="372px"
        android:foreground="?android:attr/selectableItemBackground"
        app:cardCornerRadius="8px">
        <ImageView
            android:id="@+id/mIvPoster"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/special_cloumn_img_placeholder"
            android:scaleType="fitXY"/>
        <ImageView
            android:layout_gravity="bottom"
            android:id="@+id/mIvCovered"
            android:background="@mipmap/icon_home_program_shadow"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <ImageView
            android:layout_gravity="center"
            android:background="@mipmap/icon_home_history"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/mTvEpisodeInfo"
            android:background="@mipmap/icon_home_watch"
            android:paddingLeft="10px"
            android:paddingTop="5px"
            android:paddingRight="10px"
            android:paddingBottom="5px"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""/>
        <ImageView
            android:layout_gravity="right"
            android:id="@+id/mIvTs"
            android:visibility="gone"
            android:layout_width="36px"
            android:layout_height="42px"
            android:src="@drawable/image_ts"/>
        <TextView
            android:textSize="20px"
            android:textColor="@color/color_fffefe"
            android:gravity="center"
            android:layout_gravity="bottom"
            android:id="@+id/mTvHistoryInfo"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="11px"
            android:text="2h20m"/>
        <ProgressBar
            android:layout_gravity="bottom"
            android:id="@+id/progressbar"
            android:layout_width="match_parent"
            android:layout_height="6px"
            android:layout_marginLeft="15dp"
            android:layout_marginRight="15dp"
            android:layout_marginBottom="15px"
            android:max="100"
            android:progressDrawable="@drawable/layer_list_progress_drawable"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvFreeSpace"
            style="@android:style/Widget.ProgressBar.Horizontal"/>
    </com.mobile.brasiltv.view.AutoCardView>
    <TextView
        android:textSize="24px"
        android:textColor="@color/color_ffffff"
        android:ellipsize="end"
        android:id="@+id/mTvProgramName"
        android:layout_width="221px"
        android:layout_height="wrap_content"
        android:layout_marginTop="19px"
        android:text="The Call of the Wild series 10"
        android:maxLines="2"/>
</com.zhy.autolayout.AutoLinearLayout>
