<?xml version="1.0" encoding="utf-8"?>
<com.zhy.autolayout.AutoFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mLayoutMatchRoot"
    android:background="@color/color_FF1C1D23"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMatchAll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.zhy.autolayout.AutoLinearLayout
        android:gravity="center_horizontal"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/llEmpty"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="60px">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/ivEmpty"
            android:layout_width="320px"
            android:layout_height="320px"
            android:src="@mipmap/icon_match_list_empty"/>
        <TextView
            android:textSize="24px"
            android:textColor="@color/color_FF79797F"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20px"
            android:text="@string/match_have_no_data"/>
    </com.zhy.autolayout.AutoLinearLayout>
</com.zhy.autolayout.AutoFrameLayout>
