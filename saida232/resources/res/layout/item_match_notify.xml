<?xml version="1.0" encoding="utf-8"?>
<com.zhy.autolayout.AutoFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.zhy.autolayout.AutoLinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="220px">
        <com.zhy.autolayout.AutoLinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="32px"
            android:layout_weight="1">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/ivTeamAIcon"
                android:layout_width="84px"
                android:layout_height="84px"
                android:layout_marginTop="48px"/>
            <TextView
                android:textSize="20px"
                android:textColor="@color/color_ffffff"
                android:ellipsize="marquee"
                android:id="@+id/tvTeamAName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28px"
                android:singleLine="true"/>
        </com.zhy.autolayout.AutoLinearLayout>
        <com.zhy.autolayout.AutoLinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:layout_width="254px"
            android:layout_height="wrap_content"
            android:layout_marginTop="46px">
            <TextView
                android:textSize="40px"
                android:textStyle="bold"
                android:textColor="@color/color_ffffff"
                android:id="@+id/tvTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:textSize="24px"
                android:textColor="@color/color_ffffff"
                android:gravity="center"
                android:id="@+id/tvMatchGo"
                android:background="@drawable/bg_match_notifiy_watch"
                android:layout_width="212px"
                android:layout_height="56px"
                android:layout_marginTop="38px"
                android:text="@string/match_go_watch"/>
        </com.zhy.autolayout.AutoLinearLayout>
        <com.zhy.autolayout.AutoLinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginRight="32px"
            android:layout_weight="1">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/ivTeamBIcon"
                android:layout_width="84px"
                android:layout_height="84px"
                android:layout_marginTop="48px"/>
            <TextView
                android:textSize="20px"
                android:textColor="@color/color_ffffff"
                android:ellipsize="marquee"
                android:id="@+id/tvTeamBName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28px"
                android:singleLine="true"/>
        </com.zhy.autolayout.AutoLinearLayout>
    </com.zhy.autolayout.AutoLinearLayout>
    <View
        android:layout_gravity="bottom"
        android:background="@color/color_FF3D4045"
        android:layout_width="match_parent"
        android:layout_height="2px"
        android:layout_marginLeft="24px"
        android:layout_marginRight="24px"/>
</com.zhy.autolayout.AutoFrameLayout>
