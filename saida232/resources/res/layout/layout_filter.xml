<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.mobile.brasiltv.view.KoocanEmptyView
        android:id="@+id/mKevFilterLoading"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:emptyShowType="loading"/>
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/mAppBarLayout"
        android:background="@null"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/mCollapsingToolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="80px"
            app:layout_scrollFlags="snap|exitUntilCollapsed|scroll">
            <com.zhy.autolayout.AutoLinearLayout
                android:orientation="vertical"
                android:id="@+id/mFvContainer"
                android:layout_width="match_parent"
                android:layout_height="516px"
                app:layout_collapseMode="parallax">
                <com.mobile.brasiltv.view.FilterView
                    android:id="@+id/mFvType"
                    android:paddingTop="25px"
                    android:paddingBottom="15px"
                    android:layout_width="match_parent"
                    android:layout_height="86px"/>
                <com.mobile.brasiltv.view.FilterView
                    android:id="@+id/mFvGenre"
                    android:paddingTop="15px"
                    android:paddingBottom="15px"
                    android:layout_width="match_parent"
                    android:layout_height="76px"/>
                <com.mobile.brasiltv.view.FilterView
                    android:id="@+id/mFvYear"
                    android:paddingTop="15px"
                    android:paddingBottom="15px"
                    android:layout_width="match_parent"
                    android:layout_height="76px"/>
                <com.mobile.brasiltv.view.FilterView
                    android:id="@+id/mFvCountry"
                    android:paddingTop="15px"
                    android:paddingBottom="15px"
                    android:layout_width="match_parent"
                    android:layout_height="76px"/>
                <com.mobile.brasiltv.view.FilterView
                    android:id="@+id/mFvAudio"
                    android:paddingTop="15px"
                    android:paddingBottom="25px"
                    android:layout_width="match_parent"
                    android:layout_height="86px"/>
                <com.mobile.brasiltv.view.FilterView
                    android:id="@+id/mFvRating"
                    android:paddingTop="15px"
                    android:paddingBottom="25px"
                    android:layout_width="match_parent"
                    android:layout_height="86px"/>
            </com.zhy.autolayout.AutoLinearLayout>
            <com.zhy.autolayout.AutoFrameLayout
                android:id="@+id/mCollapsingContainer"
                android:background="@color/color_bg"
                android:layout_width="match_parent"
                android:layout_height="80px"
                app:layout_collapseMode="pin">
                <TextView
                    android:textSize="28px"
                    android:textColor="@color/color_important"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/mCollapsingTitle"
                    android:paddingLeft="42px"
                    android:paddingRight="62px"
                    android:layout_width="wrap_content"
                    android:layout_height="80px"
                    android:singleLine="true"
                    android:includeFontPadding="false"/>
                <ImageView
                    android:layout_gravity="right"
                    android:paddingLeft="14px"
                    android:paddingTop="24px"
                    android:paddingRight="14px"
                    android:paddingBottom="24px"
                    android:layout_width="60px"
                    android:layout_height="80px"
                    android:src="@drawable/ic_filter_collape"
                    android:scaleType="fitXY"/>
            </com.zhy.autolayout.AutoFrameLayout>
        </com.google.android.material.appbar.CollapsingToolbarLayout>
    </com.google.android.material.appbar.AppBarLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/mRvFilterList"
        android:paddingLeft="22px"
        android:paddingRight="22px"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"/>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/mNsvStatus"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">
        <com.zhy.autolayout.AutoLinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ImageView
                android:id="@+id/mIvStatus"
                android:layout_width="252px"
                android:layout_height="196px"
                android:layout_marginTop="100dp"
                android:src="@drawable/ic_empty_record"/>
            <TextView
                android:textSize="28px"
                android:textColor="@color/color_6A6D74"
                android:gravity="center"
                android:id="@+id/mTvStatus"
                android:paddingLeft="100px"
                android:paddingRight="100px"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </com.zhy.autolayout.AutoLinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
