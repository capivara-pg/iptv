<?xml version="1.0" encoding="utf-8"?>
<com.zhy.autolayout.AutoLinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/color_FF313439"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.zhy.autolayout.AutoLinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="88px">
        <TextView
            android:textSize="32px"
            android:textColor="@color/color_ffffff"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="58px"
            android:text="@string/match_league_team_text"
            android:layout_weight="1"/>
        <ImageView
            android:id="@+id/ivClose"
            android:layout_width="48px"
            android:layout_height="48px"
            android:layout_marginLeft="32px"
            android:layout_marginRight="32px"
            android:src="@mipmap/icon_match_league_dialog_close"
            android:layout_marginHorizontal="32px"/>
    </com.zhy.autolayout.AutoLinearLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:scrollbarSize="3dp"
        android:scrollbarThumbVertical="@drawable/shape_scrollbar_thumb"
        android:scrollbarStyle="outsideInset"
        android:id="@+id/rvLeagueList"
        android:paddingLeft="24px"
        android:paddingTop="16px"
        android:paddingRight="24px"
        android:scrollbars="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="24px"
        android:layout_marginRight="24px"
        android:scrollbarFadeDuration="0"
        android:fadeScrollbars="false"
        android:layout_marginHorizontal="24px"
        android:paddingHorizontal="24px"/>
</com.zhy.autolayout.AutoLinearLayout>
