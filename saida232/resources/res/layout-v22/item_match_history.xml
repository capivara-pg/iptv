<?xml version="1.0" encoding="utf-8"?>
<com.zhy.autolayout.AutoFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.zhy.autolayout.AutoLinearLayout
        android:orientation="vertical"
        android:id="@+id/mMatchLayout"
        android:background="@drawable/bg_match_history_item"
        android:layout_width="match_parent"
        android:layout_height="244px"
        android:layout_marginTop="24px">
        <com.zhy.autolayout.AutoFrameLayout
            android:layout_width="match_parent"
            android:layout_height="58px"
            android:layout_marginLeft="40px"
            android:layout_marginTop="20px"
            android:layout_marginRight="40px"
            android:layout_marginHorizontal="40px">
            <TextView
                android:textSize="28px"
                android:textColor="@color/color_ffffff"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:layout_gravity="start|top"
                android:id="@+id/tvMatchName"
                android:layout_width="272px"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10px"
                android:singleLine="true"/>
            <TextView
                android:textSize="18px"
                android:textColor="@color/color_ffffff"
                android:layout_gravity="end|top"
                android:id="@+id/tvDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8px"
                android:layout_marginRight="12px"/>
            <View
                android:layout_gravity="bottom"
                android:background="@color/color_3A3A43"
                android:layout_width="match_parent"
                android:layout_height="2px"
                android:layout_marginTop="18px"/>
        </com.zhy.autolayout.AutoFrameLayout>
        <com.zhy.autolayout.AutoLinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.zhy.autolayout.AutoLinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="58px"
                android:layout_marginTop="28px"
                android:layout_weight="1">
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/ivTeamAIcon"
                    android:layout_width="68px"
                    android:layout_height="68px"/>
                <TextView
                    android:textSize="24px"
                    android:textColor="@color/color_8D8E91"
                    android:ellipsize="marquee"
                    android:id="@+id/tvTeamAName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12px"
                    android:singleLine="true"/>
            </com.zhy.autolayout.AutoLinearLayout>
            <TextView
                android:textSize="54px"
                android:textColor="@color/color_ffffff"
                android:gravity="center"
                android:id="@+id/tvScore"
                android:layout_width="140px"
                android:layout_height="wrap_content"
                android:layout_marginTop="24px"/>
            <com.zhy.autolayout.AutoLinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="28px"
                android:layout_marginRight="58px"
                android:layout_weight="1">
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/ivTeamBIcon"
                    android:layout_width="68px"
                    android:layout_height="68px"/>
                <TextView
                    android:textSize="24px"
                    android:textColor="@color/color_8D8E91"
                    android:ellipsize="marquee"
                    android:id="@+id/tvTeamBName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12px"
                    android:singleLine="true"/>
            </com.zhy.autolayout.AutoLinearLayout>
        </com.zhy.autolayout.AutoLinearLayout>
    </com.zhy.autolayout.AutoLinearLayout>
</com.zhy.autolayout.AutoFrameLayout>
