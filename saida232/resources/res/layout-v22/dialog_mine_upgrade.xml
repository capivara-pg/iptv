<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/bg_update_header"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/ivClose"
        android:padding="20px"
        android:visibility="visible"
        android:layout_width="80px"
        android:layout_height="80px"
        android:layout_marginTop="50px"
        android:layout_marginRight="20px"
        android:src="@drawable/icon_close_white"
        android:layout_alignParentRight="true"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="15sp"
        android:textColor="@color/color_8AFFFFFF"
        android:gravity="center"
        android:id="@+id/dialog_title"
        android:paddingTop="37px"
        android:paddingBottom="49px"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="80dp"
        android:text="@string/found_new_version_and_upgrade"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/color_important"
        android:gravity="center"
        android:id="@+id/mCopyTips"
        android:paddingLeft="60px"
        android:paddingRight="60px"
        android:paddingBottom="53px"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/upgrade_copy_tips"
        android:layout_above="@+id/mBtnTop"
        android:paddingHorizontal="60px"
        app:layout_constraintTop_toBottomOf="@+id/dialog_title"/>
    <com.mobile.brasiltv.view.KoocanButton
        android:textSize="16sp"
        android:id="@+id/mBtnTop"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginLeft="90px"
        android:layout_marginRight="90px"
        android:layout_marginBottom="40px"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/mBtnBottom"/>
    <com.mobile.brasiltv.view.KoocanButton
        android:textSize="16sp"
        android:textColor="@color/color_ffffff"
        android:id="@+id/mBtnBottom"
        android:background="@drawable/bg_upgrade_confirm_10_radius"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginLeft="90px"
        android:layout_marginRight="90px"
        android:layout_marginBottom="60px"
        android:text="@string/upgrade"
        android:layout_alignParentBottom="true"
        app:layout_constraintBottom_toTopOf="@+id/mBtnTop"
        app:layout_constraintTop_toBottomOf="@+id/mCopyTips"/>
</androidx.constraintlayout.widget.ConstraintLayout>
