<?xml version="1.0" encoding="utf-8"?>
<com.zhy.autolayout.AutoLinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:background="@drawable/shape_bg_match_calendar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="40px"
        android:textStyle="bold"
        android:textColor="@color/color_ffffff"
        android:gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="60px"
        android:text="@string/match_open_message_notify"/>
    <TextView
        android:textSize="32px"
        android:textColor="@color/color_FF8D8E91"
        android:gravity="center"
        android:paddingLeft="48px"
        android:paddingRight="48px"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16px"
        android:text="@string/match_open_calender_permissions"
        android:paddingHorizontal="48px"/>
    <TextView
        android:textSize="32px"
        android:textColor="@color/ffffff"
        android:gravity="center"
        android:id="@+id/mBtnNoNeed"
        android:background="@drawable/shape_btn_match_calendar"
        android:layout_width="442px"
        android:layout_height="88px"
        android:layout_marginTop="56px"
        android:text="@string/match_not_need"/>
    <TextView
        android:textSize="32px"
        android:textColor="@color/ffffff"
        android:gravity="center"
        android:id="@+id/mBtnAdd"
        android:background="@drawable/shape_btn_calendar_refuse"
        android:layout_width="442px"
        android:layout_height="88px"
        android:layout_marginTop="32px"
        android:layout_marginBottom="64px"
        android:text="@string/match_add_calender"/>
</com.zhy.autolayout.AutoLinearLayout>
