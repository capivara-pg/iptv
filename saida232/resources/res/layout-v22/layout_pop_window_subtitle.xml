<?xml version="1.0" encoding="utf-8"?>
<com.zhy.autolayout.AutoLinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/mLayoutSubtitle"
    android:background="@drawable/shape_bg_pop_subtitle"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.zhy.autolayout.AutoFrameLayout
        android:layout_width="match_parent"
        android:layout_height="116px">
        <TextView
            android:textSize="36px"
            android:textColor="@color/color_important_white"
            android:gravity="center"
            android:id="@+id/mTvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="33px"
            android:layout_marginTop="15px"
            android:text="@string/mine_subtitle_audio"/>
        <TextView
            android:textSize="20px"
            android:textColor="@color/color_important_white"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="33px"
            android:layout_marginTop="51px"
            android:layout_marginRight="95px"
            android:text="@string/goto_audio_subtitle_setting"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/mIvClose"
            android:padding="28px"
            android:layout_width="88px"
            android:layout_height="88px"
            android:layout_marginRight="19px"
            android:src="@drawable/icon_pop_subtitle_close"/>
    </com.zhy.autolayout.AutoFrameLayout>
    <View
        android:background="@color/color_4d4d4d"
        android:layout_width="match_parent"
        android:layout_height="1px"/>
    <TextView
        android:textSize="32px"
        android:textColor="@color/color_important_white"
        android:gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="33px"
        android:layout_marginTop="58px"
        android:text="@string/vod_audio"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/mRvAudio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="34px"
        android:layout_marginTop="20px"/>
    <TextView
        android:textSize="32px"
        android:textColor="@color/color_important_white"
        android:gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="33px"
        android:layout_marginTop="58px"
        android:text="@string/subtitle_dialog_setting"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/mRvLanguage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="34px"
        android:layout_marginTop="20px"/>
    <TextView
        android:textSize="32px"
        android:textColor="@color/color_important_white"
        android:gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="33px"
        android:layout_marginTop="58px"
        android:text="@string/subtitle_time"/>
    <LinearLayout
        android:layout_gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="22dp"
        android:layout_marginTop="13dp">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/ivForward"
            android:padding="5dp"
            android:nextFocusLeft="@+id/ivForward"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginRight="10dp"
            android:src="@mipmap/icon_subtitle_time_forward"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/tvTime"
            android:background="@drawable/shape_bg_subtitle_time_focus"
            android:layout_width="66dp"
            android:layout_height="32dp"/>
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/ivBack"
            android:padding="5dp"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginLeft="10dp"
            android:src="@mipmap/icon_subtitle_time_back"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/color_ffffff"
            android:gravity="center"
            android:id="@+id/tvReset"
            android:background="@drawable/shape_bg_subtitle_time_reset_focus"
            android:paddingLeft="21px"
            android:paddingTop="11px"
            android:paddingRight="21px"
            android:paddingBottom="11px"
            android:nextFocusRight="@+id/tvReset"
            android:layout_width="83dp"
            android:layout_height="32dp"
            android:layout_marginLeft="40px"
            android:text="@string/reset"
            android:paddingHorizontal="21px"
            android:paddingVertical="11px"/>
    </LinearLayout>
    <TextView
        android:textSize="32px"
        android:textColor="@color/color_important_white"
        android:gravity="center"
        android:id="@+id/mTvSizeTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="33px"
        android:layout_marginTop="60px"
        android:text="@string/subtitle_size"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/mRvSize"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="34px"
        android:layout_marginTop="20px"/>
    <TextView
        android:textSize="32px"
        android:textColor="@color/color_important_white"
        android:gravity="center"
        android:id="@+id/mTvStyleTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="33px"
        android:layout_marginTop="60px"
        android:text="@string/subtitle_Style"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/mRvColor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="34px"
        android:layout_marginTop="20px"
        android:layout_marginBottom="20px"/>
</com.zhy.autolayout.AutoLinearLayout>
